# 复制为 .env 后修改
SHT_HEADLESS=0
# 与 playwright codegen 存 storage 时一致时填 0（默认）。save_login 移动版脚本=1
SHT_XHS_EMULATE_MOBILE=0
# 见 Playwright devices，如 iPhone 12, Pixel 5
SHT_XHS_DEVICE=iPhone 12
# 搜索页若出现「你访问的页面不见了」可改为 minimal（仅带 keyword 参数）
SHT_XHS_SEARCH_URL_MODE=try_all
SHT_DELAY_MIN=2.0
SHT_DELAY_MAX=8.0
SHT_EXPORT_DIR=data/exports
# 去重：已见笔记指纹（见 fingerprints.py / run_crawl --dedup）
SHT_FINGERPRINTS_PATH=data/seen_fingerprints.json
SHT_STORAGE_XHS=data/storage_state_xhs.json
# 抖音
SHT_STORAGE_DOUYIN=data/storage_state_douyin.json
SHT_DOUYIN_EXPORT_SUBDIR=douyin
SHT_DOUYIN_LIST_SCROLL=4
SHT_DOUYIN_GOTO_TIMEOUT_MS=90000
SHT_DOUYIN_SEARCH_MAX_HREFS=40
SHT_DOUYIN_CREATOR_UPLOAD_URL=https://creator.douyin.com/upload/
SHT_DOUYIN_TITLE_INPUT_SELECTORS=input[placeholder*='标题'],textarea[placeholder*='标题'],input[aria-label*='标题']
SHT_DOUYIN_PUBLISH_DELAY_MIN=0.3
SHT_DOUYIN_PUBLISH_DELAY_MAX=1.0
SHT_USER_DATA_DIR=
# 小红书选择器全失败时是否落盘（1=开启）
XHS_DEBUG=0
# 落盘目录（可改）
SHT_DEBUG_HTML_DIR=data/debug
