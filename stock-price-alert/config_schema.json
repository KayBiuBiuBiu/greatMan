{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/stock-price-alert/config-merged",
  "title": "stock-price-alert merged config (post merge_full_config)",
  "$comment": "与 run_alert.merge_full_config 输出保持同步：新增默认节或字段时，请在此补 properties/required。根 additionalProperties=true 允许未知顶层键（不做类型校验）；各已知节内已列字段会做类型校验，未列子键仍允许（节上 additionalProperties=true）。含 data_health、logging、trend_slippage_alert.atr_tiers（P1-6/P2-3/P1-2）。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "legal": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "disclaimer_suffix": { "type": "string", "minLength": 1 }
      }
    },
    "poll_interval_seconds": {
      "type": ["integer", "number"],
      "minimum": 1
    },
    "trading_closed_interval": {
      "type": ["integer", "number"],
      "minimum": 1
    },
    "alert_cooldown_minutes": {
      "type": ["integer", "number"],
      "minimum": 0
    },
    "alert_price_buffer": {
      "type": ["integer", "number"],
      "minimum": 0
    },
    "run_only_in_trading_hours": { "type": "boolean" },
    "monitoring": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "watchlist_only": { "type": "boolean" }
      }
    },
    "midday_ops": {
      "type": "object",
      "additionalProperties": true,
      "description": "午休 11:30–13:00：优质股展示过滤、持仓策略临近价提示、可选流动性预警（不写 daily_picks.json）",
      "properties": {
        "enabled": { "type": "boolean" },
        "poll_during_lunch": { "type": "boolean" },
        "run_refresh_after_hhmm": { "type": "string" },
        "max_intraday_position": { "type": ["integer", "number"] },
        "precompute_up_pct": { "type": ["integer", "number"] },
        "precompute_down_pct": { "type": ["integer", "number"] },
        "liquidity_warn_equiv_30m_wan": { "type": ["integer", "number"] },
        "liquidity_use_akshare_spot": { "type": "boolean" }
      }
    },
    "afternoon_refresh": {
      "type": "object",
      "additionalProperties": true,
      "description": "午休 11:30–13:00 过 trigger_time 后：从 daily_picks 优质∪观察 ∪ watchlist 与上午行情筛选，写 afternoon_picks.json；13:00+ 分区【下午机会·新增】。量比为近5日全日均量按进度估算同时段的工程近似",
      "properties": {
        "enabled": { "type": "boolean" },
        "trigger_time": { "type": "string" },
        "max_picks": { "type": "integer", "minimum": 1 },
        "poll_during_lunch": { "type": "boolean" },
        "min_chg_pct": { "type": ["integer", "number"] },
        "max_chg_pct": { "type": ["integer", "number"] },
        "min_vol_ratio": { "type": ["integer", "number"] },
        "max_intraday_position": {
          "type": ["integer", "number"],
          "minimum": 0,
          "maximum": 1,
          "description": "日内位置须严格小于该阈值（现价在当日上午高低区间的相对位置）"
        },
        "use_akshare_volume": { "type": "boolean" },
        "pm_use_afternoon_quality_pool": {
          "type": "boolean",
          "description": "true 时 13:00+ 用文件中 quality_display_codes 替换「今日优质股」底集（默认 false）"
        }
      }
    },
    "quant_selector": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "score_min_quality": { "type": ["integer", "number"] },
        "score_min_watch": { "type": ["integer", "number"] },
        "profit_1y_min": { "type": ["integer", "number"] },
        "win_1y_min": { "type": ["integer", "number"] },
        "profit_3y_floor": { "type": ["integer", "number"] },
        "exclude_star_board": {
          "type": "boolean",
          "description": "日选股全市场列表剔除 688/689 科创板"
        },
        "use_tushare_for_daily": { "type": "boolean" },
        "tushare_rt_k_enabled": { "type": "boolean" },
        "use_stock_basic_cache_universe": {
          "type": "boolean",
          "description": "选股全市场代码优先从 data/stock_basic_cache.json（Tushare stock_basic）读取；关闭或缓存无效时回退 AkShare"
        },
        "per_stock_sleep_sec": {
          "type": ["integer", "number"],
          "minimum": 0,
          "description": "每只股处理后的额外停顿（秒），用于非 Tushare 源限频；默认 0"
        },
        "daily_select_max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "选股评分+回测并发线程数；Baostock/AkShare 回退路径会自动串行化，Tushare 下可拉高"
        },
        "use_sqlite_cache": {
          "type": "boolean",
          "description": "Tushare 日 K：优先读 kline_store SQLite（与 sync 写入的前复权口径一致），不足或过时再 pro_bar"
        },
        "max_stale_calendar_days": {
          "type": "integer",
          "minimum": 0,
          "description": "SQLite 命中条件：库中最新 trade_date 距今天历日不超过此值（默认 2，与 sync 增量类似）"
        },
        "picks_history_snapshot": {
          "type": "object",
          "additionalProperties": true,
          "description": "选股完成后将 daily_picks.json 复制到 picks_history/YYYY-MM-DD.json，供 backtest_picks_performance.py",
          "properties": {
            "enabled": { "type": "boolean" },
            "dir": { "type": "string" }
          }
        },
        "select_candidate_filters": {
          "type": "object",
          "additionalProperties": true,
          "description": "对优质/观察候选：近 N 日区间位置、策略卖出侧参考分过滤；淘汰写入 reason。watchlist 持仓标签可豁免（监控仍由 run_alert 保留）",
          "properties": {
            "enabled": { "type": "boolean" },
            "range_lookback_days": { "type": "integer", "minimum": 5, "maximum": 252 },
            "range_position_max": { "type": ["integer", "number"], "minimum": 0, "maximum": 1 },
            "strategy_sell_score_max": { "type": ["integer", "number"], "minimum": 0, "maximum": 100 },
            "skip_if_has_position_tag": { "type": "boolean" }
          }
        },
        "sw_l1_pool": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "picks_per_industry": { "type": ["integer", "number"], "minimum": 1 },
            "max_stocks": { "type": ["integer", "number"], "minimum": 1 },
            "min_score": { "type": ["integer", "number", "null"] },
            "strength_tiers_enabled": { "type": "boolean" },
            "strength_lookback_days": { "type": ["integer", "number"], "minimum": 1 },
            "use_relative_to_index": { "type": "boolean" },
            "strength_benchmark_ts_code": { "type": "string" },
            "strength_fetch_sleep_sec": { "type": ["integer", "number"], "minimum": 0 },
            "top_third_picks": { "type": ["integer", "number"], "minimum": 0 },
            "mid_third_picks": { "type": ["integer", "number"], "minimum": 0 },
            "bottom_third_max_picks": { "type": ["integer", "number"], "minimum": 0 },
            "bottom_tier_min_score": { "type": ["integer", "number", "null"] },
            "bottom_tier_min_score_delta": { "type": ["integer", "number"] },
            "unmapped_strength_tier": { "type": "string" }
          },
          "description": "申万一级去重；可选 strength_tiers：按行业近 N 日涨跌（相对基准）分三档动态名额，末档需更高分；数据不足时回退均匀 picks_per_industry"
        },
        "cluster_pool": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "after_sw_l1": { "type": "boolean" },
            "n_clusters": { "type": ["integer", "number"], "minimum": 2 },
            "picks_per_cluster": { "type": ["integer", "number"], "minimum": 1 },
            "max_stocks": { "type": ["integer", "number"], "minimum": 1 },
            "min_score": { "type": ["integer", "number", "null"] },
            "random_state": { "type": ["integer", "number", "null"] },
            "features": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "description": "对优质股日 K 技术特征做 K-means，每簇按 score 择优；after_sw_l1 控制与申万去重顺序"
        },
        "afternoon_repeat_boost": {
          "type": "object",
          "additionalProperties": true,
          "description": "下午机会列表按日累计；盘前选股对 get_real_score 加小分（需 config_parent 与 afternoon_refresh 写 hits）",
          "properties": {
            "enabled": { "type": "boolean" },
            "lookback_calendar_days": { "type": "integer", "minimum": 1 },
            "points_per_distinct_day": { "type": ["integer", "number"], "minimum": 0 },
            "max_bonus": { "type": ["integer", "number"], "minimum": 0 },
            "state_path": { "type": "string" },
            "retain_calendar_days": { "type": "integer", "minimum": 7 }
          }
        }
      }
    },
    "strategy_signal": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min_score_by_strategy": {
          "type": "object",
          "additionalProperties": { "type": ["integer", "number"] }
        }
      }
    },
    "strategy_buy_filter": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "min_volume_ratio": { "type": ["integer", "number"] },
        "block_weak_bear": { "type": "boolean" },
        "use_intraday_position_filter": { "type": "boolean" },
        "min_intraday_position": { "type": ["integer", "number"] },
        "max_intraday_position": { "type": ["integer", "number"] },
        "sector_buy_cross_check": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "type": "string" },
            "min_evaluated_dims": { "type": ["integer", "number"] },
            "min_pass_votes": { "type": ["integer", "number"] },
            "pass_weighted_threshold": { "type": ["integer", "number"] },
            "weights": {
              "type": "object",
              "additionalProperties": { "type": ["integer", "number"] }
            },
            "sector_rs_vs_index_margin": { "type": ["integer", "number"] },
            "ma20_tolerance": { "type": ["integer", "number"] },
            "stock_vs_sector_max_lag": { "type": ["integer", "number"] },
            "require_sector_bk": { "type": "boolean" }
          }
        },
        "adaptive_by_mood": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "strong_bull": { "type": "object", "additionalProperties": true },
            "range": { "type": "object", "additionalProperties": true },
            "weak_bear": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "scan_pool_max": {
      "type": ["integer", "number"],
      "minimum": 0,
      "description": "每日评分+回测抽样上限；0 表示全市场（不截断）"
    },
    "daily_pick_count": {
      "type": ["integer", "number"],
      "minimum": 1
    },
    "dip_display_filter": {
      "type": "object",
      "additionalProperties": true,
      "description": "控制台「低吸优选」与「其余监控」（未进优选池部分）展示：涨幅/日内位置过高则跳过；不按是否持仓或 tags 豁免（轮询与告警仍覆盖全 watchlist）",
      "properties": {
        "enabled": { "type": "boolean" },
        "max_change_pct": { "type": ["integer", "number"] },
        "max_intraday_position": { "type": ["integer", "number"], "minimum": 0, "maximum": 1 }
      }
    },
    "capital": {
      "type": "object",
      "additionalProperties": true,
      "required": ["total", "max_total_position_ratio", "max_single_stock_ratio"],
      "properties": {
        "total": { "type": ["integer", "number"], "minimum": 0 },
        "max_total_position_ratio": { "type": ["integer", "number"], "minimum": 0, "maximum": 1 },
        "max_single_stock_ratio": { "type": ["integer", "number"], "minimum": 0, "maximum": 1 }
      }
    },
    "buy_rule": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "base_position",
        "add_1_ratio",
        "add_1_money",
        "add_2_ratio",
        "add_2_money",
        "forbid_add_ratio"
      ],
      "properties": {
        "base_position": { "type": ["integer", "number"] },
        "add_1_ratio": { "type": ["integer", "number"] },
        "add_1_money": { "type": ["integer", "number"] },
        "add_2_ratio": { "type": ["integer", "number"] },
        "add_2_money": { "type": ["integer", "number"] },
        "forbid_add_ratio": { "type": ["integer", "number"] }
      }
    },
    "risk_rule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["stop_loss_ratio", "take_profit_short", "take_profit_wave"],
      "properties": {
        "stop_loss_ratio": { "type": ["integer", "number"] },
        "take_profit_short": { "type": ["integer", "number"] },
        "take_profit_wave": { "type": ["integer", "number"] }
      }
    },
    "drawdown_alert": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "warn_1_ratio", "warn_2_ratio"],
      "properties": {
        "enabled": { "type": "boolean" },
        "warn_1_ratio": { "type": ["integer", "number"] },
        "warn_2_ratio": { "type": ["integer", "number"] },
        "warn_3_ratio": { "type": ["integer", "number", "null"] },
        "alert_ignore_codes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "trend_slippage_alert": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "min_pillars_weak",
        "stock_min_weak_dims",
        "sector_min_weak_dims",
        "index_weak_mult_max",
        "index_5d_ret_weak",
        "volume_spike_vs_ma20",
        "near_high_20_ratio",
        "atr_tiers"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "min_pillars_weak": { "type": ["integer", "number"], "minimum": 1 },
        "stock_min_weak_dims": { "type": ["integer", "number"], "minimum": 1 },
        "sector_min_weak_dims": { "type": ["integer", "number"], "minimum": 1 },
        "index_weak_mult_max": { "type": ["integer", "number"] },
        "index_5d_ret_weak": { "type": ["integer", "number"] },
        "volume_spike_vs_ma20": { "type": ["integer", "number"], "minimum": 0 },
        "near_high_20_ratio": { "type": ["integer", "number"], "minimum": 0, "maximum": 1 },
        "require_resolved_bk": { "type": "boolean" },
        "verbose_trend_alert": { "type": "boolean" },
        "min_price": { "type": ["integer", "number"], "minimum": 0 },
        "min_float_mv_yi": { "type": ["integer", "number"], "minimum": 0 },
        "min_volume_ratio": { "type": ["integer", "number"], "minimum": 0 },
        "alert_ignore_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "require_consecutive_trade_days": {
          "type": ["integer", "number"],
          "minimum": 1,
          "description": "趋势下滑需连续 N 个交易日柱走弱才推送（>1 时写 SQLite streak，与 kline_store 同库）"
        },
        "dynamic_adaptive": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "ma_period": { "type": ["integer", "number"], "minimum": 5, "maximum": 120 },
            "bull_min_pillars": { "type": ["integer", "number"], "minimum": 1, "maximum": 4 },
            "bear_min_pillars": { "type": ["integer", "number"], "minimum": 1, "maximum": 4 },
            "volume_ratio_active": { "type": ["integer", "number"], "minimum": 0 },
            "use_volume_filter": { "type": "boolean" },
            "use_mood_three_tier": { "type": "boolean" },
            "strong_bull_min_pillars": { "type": ["integer", "number"], "minimum": 1, "maximum": 4 },
            "range_min_pillars": { "type": ["integer", "number"], "minimum": 1, "maximum": 4 },
            "weak_bear_min_pillars": { "type": ["integer", "number"], "minimum": 1, "maximum": 4 },
            "rsi_period": { "type": ["integer", "number"], "minimum": 2, "maximum": 30 },
            "mood_rsi_period": { "type": ["integer", "number"], "minimum": 2, "maximum": 30 },
            "rsi_strong_bull_min": { "type": ["integer", "number"], "minimum": 0, "maximum": 100 },
            "mood_rsi_bull": { "type": ["integer", "number"], "minimum": 0, "maximum": 100 },
            "rsi_weak_bear_max": { "type": ["integer", "number"], "minimum": 0, "maximum": 100 },
            "mood_rsi_bear": { "type": ["integer", "number"], "minimum": 0, "maximum": 100 },
            "bb_period": { "type": ["integer", "number"], "minimum": 5, "maximum": 60 },
            "mood_bb_period": { "type": ["integer", "number"], "minimum": 5, "maximum": 60 },
            "bb_width_min_for_strong": { "type": ["integer", "number"], "minimum": 0 },
            "mood_bb_width_bull": { "type": ["integer", "number"], "minimum": 0 },
            "sector_rs_enabled": { "type": "boolean" },
            "sector_rs_ret_days": { "type": ["integer", "number"], "minimum": 5, "maximum": 60 },
            "sector_rs_outperform_pct": { "type": ["integer", "number"] },
            "sector_rs_underperform_pct": { "type": ["integer", "number"] },
            "sector_rs_strong_delta": { "type": ["integer", "number"], "minimum": -3, "maximum": 3 },
            "sector_rs_weak_delta": { "type": ["integer", "number"], "minimum": -3, "maximum": 3 }
          }
        },
        "atr_tiers": {
          "type": "object",
          "additionalProperties": true,
          "required": ["enabled", "lookback", "tiers"],
          "properties": {
            "enabled": { "type": "boolean" },
            "method": {
              "type": "string",
              "description": "wilder（默认）或 simple_ma / sma / simple"
            },
            "lookback": { "type": ["integer", "number"], "minimum": 2 },
            "tiers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "stock_min_weak_dims",
                  "sector_min_weak_dims",
                  "min_pillars_weak"
                ],
                "properties": {
                  "max_close_atr_pct": { "type": ["integer", "number", "null"] },
                  "stock_min_weak_dims": { "type": ["integer", "number"], "minimum": 1 },
                  "sector_min_weak_dims": { "type": ["integer", "number"], "minimum": 1 },
                  "min_pillars_weak": { "type": ["integer", "number"], "minimum": 1 }
                }
              }
            }
          }
        }
      }
    },
    "sector_index_overrides": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "performance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kline_cache_ttl_sec",
        "sector_kline_cache_ttl_sec",
        "index_kline_cache_ttl_sec",
        "enable_parallel_fetch",
        "fetch_max_workers",
        "fetch_max_concurrency"
      ],
      "properties": {
        "kline_cache_ttl_sec": { "type": ["integer", "number"] },
        "sector_kline_cache_ttl_sec": { "type": ["integer", "number"] },
        "index_kline_cache_ttl_sec": { "type": ["integer", "number"] },
        "enable_parallel_fetch": { "type": "boolean" },
        "fetch_max_workers": { "type": ["integer", "number"], "minimum": 1 },
        "fetch_max_concurrency": { "type": ["integer", "number"], "minimum": 1 },
        "request_min_interval_sec": { "type": ["integer", "number"], "minimum": 0 },
        "hub_poll_start_offset_sec": { "type": ["integer", "number"], "minimum": 0 },
        "hub_warm_timeout_sec": { "type": ["integer", "number"], "minimum": 0 },
        "hub_warm_min_fraction": { "type": ["integer", "number"], "minimum": 0, "maximum": 1 },
        "fetch_minute_kline_today": {
          "type": "boolean",
          "default": false,
          "description": "为 true 时主轮询内同步拉取当日 1 分钟 K 写入 pack[\"minute_kline\"]；请求量更大，默认 false"
        },
        "minute_kline_max_bars": { "type": ["integer", "number"], "minimum": 8 },
        "minute_kline_cache_ttl_sec": { "type": ["integer", "number"], "minimum": 0 },
        "minute_kline_max_per_round": { "type": ["integer", "number"], "minimum": 0 },
        "minute_kline_am_session_only": { "type": "boolean" },
        "log_poll_segment_ms": {
          "type": "boolean",
          "description": "为 true 时输出各阶段 ms 与按墙钟排序的单票拉取耗时（慢→快，并行下为整包耗时）"
        },
        "async_minute_kline": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "refresh_sec": { "type": ["integer", "number"], "minimum": 30 },
            "max_bars": { "type": ["integer", "number"], "minimum": 32 }
          }
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "aggregate_interval_alerts": { "type": "boolean" },
        "aggregate_max_items": { "type": ["integer", "number"], "minimum": 1 },
        "aggregate_trend_alerts": { "type": "boolean" },
        "aggregate_trend_max_items": { "type": ["integer", "number"], "minimum": 1 },
        "remote_channel": {
          "type": "string",
          "description": "email | wecom | both | none；控制 send_email_alert 等远程投递"
        },
        "wecom_webhook": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "webhook_url": { "type": "string" },
            "msgtype": { "type": "string", "description": "text 或 markdown" }
          }
        }
      }
    },
    "kline_store": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "db_path": { "type": "string" },
        "fresh_hours_after_sync": { "type": ["integer", "number"], "minimum": 0 },
        "divergence_warn_price_pct": { "type": ["integer", "number", "null"], "minimum": 0 },
        "sync_skip_min_bars": { "type": ["integer", "number"], "minimum": 1 },
        "sync_max_stale_calendar_days": { "type": ["integer", "number"], "minimum": 0 },
        "sync_fetch_lmt": { "type": ["integer", "number"], "minimum": 40 },
