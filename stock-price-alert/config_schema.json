          "type": "object",
          "additionalProperties": true,
          "description": "Tushare：指数 index_daily+rt_idx_k；个股 pro_bar(qfq)/daily+rt_k；申万 sw_daily（回退 sw_index_daily）+rt_sw_idx_k",
          "properties": {
            "enabled": { "type": "boolean" },
            "token": { "type": "string" },
            "token_env": { "type": "string" },
            "daily_max_per_minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500,
              "description": "全进程 pro_bar / daily / daily_basic(trade_date) 滑动窗口限流：每分钟最多次数（默认 500，与官方 daily 额度一致；0=不限制）"
            },
            "sh_index_free_fallback": {
              "type": "boolean",
              "description": "已废弃：上证仅走 Tushare"
            },
            "stock_rt_k_enabled": {
              "type": "boolean",
              "description": "为 true 且 Tushare 已启用时，个股日 K 合并 rt_k"
            },
            "stock_rt_k_fallback": {
              "type": "boolean",
              "description": "已废弃：不再使用东财补最后一根"
            },
            "sw_enabled": {
              "type": "boolean",
              "description": "申万行业指数 K 线（sw_daily，回退 sw_index_daily；合并 rt_sw_idx_k）"
            },
            "stock_basic_cache_path": {
              "type": "string",
              "description": "stock_basic 本地 JSON，供选股与名称表"
            },
            "stock_to_sw_path": {
              "type": "string",
              "description": "股票→申万一级指数 ts_code 映射 JSON"
            },
            "pro_dataapi_base": {
              "type": "string",
              "description": "Tushare Pro DataApi 基址（无尾斜杠），实际请求为 {base}/{api_name}。默认可解析域名 https://api.tushare.pro/dataapi；亦可设环境变量 TUSHARE_PRO_DATAAPI_BASE 覆盖"
            },
            "pro_dataapi_fallbacks": {
              "type": "array",
              "items": { "type": "string" },
              "description": "主基址失败时的额外候选 URL（无尾斜杠）。亦可用环境变量 TUSHARE_PRO_DATAAPI_FALLBACKS 逗号分隔。默认会在链中自动加入 api.tushare.pro 与 api.waditu.com（去重）"
            },
            "dataapi_connect_retries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "description": "每个 DataApi 基址上，对连接重置/断管/DNS/HTTP 非 2xx/服务端繁忙文案等的重试次数（默认 5）"
            },
            "dataapi_retry_base_delay_sec": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 5,
              "description": "重试退避基数秒，实际 sleep = 基数 × 2^attempt（默认 0.45）"
            }
          }
        }
      }
    },
    "data_health": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "host_consecutive_fail_threshold": { "type": ["integer", "number"], "minimum": 1 },
        "backoff_cap_sec": { "type": ["integer", "number"], "minimum": 0 },
        "backoff_base_sec": { "type": ["integer", "number"], "minimum": 0 },
        "full_outage_consecutive_notify_threshold": { "type": ["integer", "number"], "minimum": 0 },
        "full_outage_email_enabled": {
          "type": "boolean",
          "description": "true（默认）：全源连续不可用达阈值时另发邮件/企微；false 则仅本机通知等"
        },
        "recovery_notify_enabled": { "type": "boolean" },
        "suppress_trend_rounds_after_full_outage": { "type": ["integer", "number"], "minimum": 0 },
        "heartbeat_path": {
          "type": "string",
          "description": "非空则定期写入 JSON 心跳文件（相对项目根）；空字符串关闭"
        },
        "heartbeat_interval_sec": { "type": ["integer", "number"], "minimum": 30 }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "file": { "type": "string" },
        "max_bytes": { "type": ["integer", "number"], "minimum": 1000 },
        "backup_count": { "type": ["integer", "number"], "minimum": 1 },
        "level": { "type": "string" },
        "console_mirror": { "type": "boolean" }
      }
    },
    "watchlist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["code", "market", "enabled"],
        "properties": {
          "name": { "type": "string" },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "market": {
            "type": "string",
            "pattern": "^(sh|sz|bj|SH|SZ|BJ)$"
          },
          "enabled": { "type": "boolean" },
          "cost_price": {
            "type": ["null", "integer", "number"]
          },
          "hold_shares": {
            "type": ["null", "integer", "number"],
            "minimum": 0
          },
          "alert_mode": {
            "type": "string",
            "pattern": "^(breach|band|BREACH|BAND)$"
          },
          "alert_below": { "type": ["integer", "number", "null"] },
          "alert_above": { "type": ["integer", "number", "null"] },
          "note": { "type": "string" },
          "tags": { "type": "string" },
          "industry": { "type": "string" }
        }
      }
    }
  },
  "required": [
    "poll_interval_seconds",
    "trading_closed_interval",
    "alert_cooldown_minutes",
    "alert_price_buffer",
    "run_only_in_trading_hours",
    "scan_pool_max",
    "daily_pick_count",
    "capital",
    "buy_rule",
    "risk_rule",
    "drawdown_alert",
    "trend_slippage_alert",
    "sector_index_overrides",
    "performance",
    "kline_store",
    "realtime_hub",
    "ml_filter",
    "ml_forward4",
    "ops_automation",
    "email_command_bot",
    "sector_em",
    "scan_rule",
    "scan_meta",
    "macro_risk",
    "sources",
    "data_health",
    "logging",
    "watchlist"
  ]
}
