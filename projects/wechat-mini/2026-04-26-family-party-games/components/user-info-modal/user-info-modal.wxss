/* 聚会形象弹窗 — 对齐项目 tokens：主色 #FF7A2F，卡片圆角 32rpx */

.uim-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: var(--color-mask, rgba(0, 0, 0, 0.5));
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.uim-card {
  width: 600rpx;
  padding: 48rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 12rpx 48rpx rgba(35, 33, 42, 0.1);
}

.uim-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #23212a;
  text-align: center;
  line-height: 56rpx;
  margin-bottom: 32rpx;
}

.uim-desc {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 40rpx;
  margin-bottom: 32rpx;
}

.uim-error {
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fff5f0;
  color: #ea580c;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.uim-avatar-block {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.uim-avatar-btn {
  width: 120rpx !important;
  min-width: 120rpx;
  max-width: 120rpx;
  margin: 0 auto;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.uim-avatar-btn::after {
  border: none;
}

.uim-avatar-ring {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 9999rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #f5f5f5;
}

.uim-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.uim-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #fdba74, #ff7a2f);
}

.uim-avatar-plus {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 500;
  line-height: 1;
}

.uim-avatar-loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.uim-loading-text {
  color: #ffffff;
  font-size: 22rpx;
}

.uim-avatar-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #7b7280;
  line-height: 34rpx;
}

.uim-nick-wrap {
  width: 100%;
  margin-bottom: 40rpx;
}

.uim-nick-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f5f5f5;
  border: none;
  font-size: 28rpx;
  color: #23212a;
}

.uim-nick-ph {
  color: #999999;
  font-size: 28rpx;
}

.uim-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.uim-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.uim-btn::after {
  border: none;
}

.uim-btn-secondary {
  background: transparent;
  color: #666666;
  border: 2rpx solid #e5e5e5;
  box-sizing: border-box;
  line-height: 84rpx;
}

.uim-btn-primary {
  background: #ff7a2f;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 47, 0.35);
}

.uim-btn-primary[disabled] {
  opacity: 0.5;
  box-shadow: none;
}
