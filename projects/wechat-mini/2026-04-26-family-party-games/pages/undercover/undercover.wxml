<!-- 未进房 -->
<view class="page ucv2" wx:if="{{!roomId}}">
  <view class="hero rg-lobby-hero">
    <view class="hero-title">🕵️ 谁是卧底</view>
    <view class="hero-subtitle">同场猜词：每人本机看词、投票。凭 6 位数字口令进组，至少 3 人且需凑满目标人数。</view>
  </view>
  <view class="rg-room-card">
    <view class="rg-lobby-label">昵称</view>
    <input class="rg-lobby-inp" placeholder="输入昵称" value="{{nick}}" bindinput="onNick" />
    <button class="btn btn-primary main-btn" bindtap="doCreate" disabled="{{opBusy}}">创建聚会组</button>
    <view class="rg-lobby-label" style="margin-top: var(--space-md)">已有口令</view>
    <input class="rg-lobby-inp" type="number" maxlength="6" value="{{joinCode}}" bindinput="onCode" placeholder="6 位数字" />
    <button class="btn btn-secondary main-btn" bindtap="doJoin" disabled="{{opBusy}}">加入互动组</button>
  </view>
</view>

<!-- 已进房 · 大厅 -->
<block wx:else>
  <view class="page ucv2 ucv2-inroom">
    <view class="hero rg-lobby-hero rg-lobby-hero-compact">
      <view class="hero-title">🕵️ 谁是卧底</view>
      <view class="hero-subtitle text-caption" wx:if="{{state && state.currentPhase && state.currentPhase !== 'waiting' && state.currentPhase !== 'ended'}}">
        第 {{state.currentRound || 0}} 轮 · {{state.currentPhase}}
      </view>
    </view>

    <view class="rg-room-card">
      <view class="rg-code-row">
        <view class="rg-code-main">
          <text class="rg-code-label">聚会组口令</text>
          <view class="rg-code-num-row rg-code-tap" bindtap="onCopyRoomCode">
            <text class="rg-code-num">{{roomCode || (state && state.roomCode)}}</text>
          </view>
        </view>
        <button class="btn-wechat-invite rg-invite-btn" open-type="share">邀请朋友</button>
      </view>
      <view
        class="rg-status-banner {{statusBannerWarn ? 'rg-banner-warn' : ''}}"
        wx:if="{{statusHint}}"
      >{{statusHint}}</view>
    </view>

    <view class="rg-room-card" wx:if="{{state}}">
      <view class="rg-members-card rg-members-inner">
        <view class="rg-members-head">
          <text class="rg-members-title">成员</text>
          <text class="rg-members-count muted">{{memberCountLine}}</text>
        </view>
        <view class="rg-progress-wrap" wx:if="{{inWaiting && (state.maxPlayers || sizeList[sizeIndex])}}">
          <view class="rg-progress-bar">
            <view class="rg-progress-fill" style="width: {{playerProgressPct}}%;"></view>
          </view>
        </view>
        <view class="rg-empty-members text-caption" wx:if="{{!displayPlayers || !displayPlayers.length}}">
          暂无成员，请点「邀请朋友」或分享口令
        </view>
        <view class="rg-member-list">
          <view class="rg-member-item" wx:for="{{displayPlayers}}" wx:for-item="p" wx:key="openId">
            <view class="rg-avatar">{{p.avatarText}}</view>
            <view class="rg-member-body">
              <view class="rg-member-name-row">
                <text class="rg-member-name">{{p.nickName}}</text>
                <text class="rg-host-badge" wx:if="{{p.isHost}}">👑</text>
                <view class="rg-ready-dot {{p.ready ? 'on' : ''}}"></view>
              </view>
              <text class="rg-ready-label">{{p.readyLabel}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <block wx:if="{{inWaiting && view && view.isHost}}">
      <view class="rg-settings-card">
        <view class="rg-setting-item">
          <text class="rg-label">目标人数</text>
          <view class="rg-stepper-board">
            <view
              class="stepper-btn {{sizeIndex <= 0 ? 'stepper-btn-disabled' : ''}}"
              bindtap="onSizeDecrease"
            >-</view>
            <text class="stepper-value">{{sizeList[sizeIndex]}}</text>
            <view
              class="stepper-btn {{sizeIndex >= sizeList.length - 1 ? 'stepper-btn-disabled' : ''}}"
              bindtap="onSizeIncrease"
            >+</view>
          </view>
        </view>
        <view class="rg-stepper-hint">{{ucSizeHint}}</view>
        <view class="rg-setting-item">
          <text class="rg-label">词库来源</text>
          <picker
            mode="selector"
            range="{{wordSourceOptions}}"
            value="{{wordSourceIdx}}"
            bindchange="onWordSourceChange"
          >
            <view class="rg-picker">{{wordSourceLabel}}</view>
          </picker>
        </view>
        <view class="rg-settings-row rg-settings-row-last" wx:if="{{wordSource === 'ai'}}">
          <view class="rg-settings-item rg-settings-item-full">
            <text class="rg-label">难度</text>
            <view class="rg-seg-row">
              <view class="rg-seg {{aiDiffIdx === 0 ? 'active' : ''}}" data-idx="0" bindtap="onAiDiffTap">简单</view>
              <view class="rg-seg {{aiDiffIdx === 1 ? 'active' : ''}}" data-idx="1" bindtap="onAiDiffTap">中等</view>
              <view class="rg-seg {{aiDiffIdx === 2 ? 'active' : ''}}" data-idx="2" bindtap="onAiDiffTap">困难</view>
            </view>
          </view>
        </view>
        <view class="rg-preview-inline" wx:if="{{wordSource === 'ai' && aiPreviewPair}}">
          <text class="rg-preview-inline-title">已生成词对（预览）</text>
          <text class="rg-preview-inline-word">平民：{{aiPreviewPair.civilianWord}} · 卧底：{{aiPreviewPair.undercoverWord}}</text>
        </view>
        <view class="rg-ai-action" wx:if="{{aiUnlock.canGen}}">
          <button class="btn-ai" bindtap="doAiGenWords" disabled="{{aiBusy}}">✨ AI 生成词对</button>
        </view>
        <view class="rg-ai-locked" wx:else>
          <button class="btn-ai ai-locked" bindtap="onAiUnlockTap">🔒 AI 生成词对</button>
        </view>
        <view class="rg-settings-tip">仅生成预览，点「开始互动」后使用</view>
      </view>
      <button
        class="rg-btn-primary main-btn rg-start-btn {{canStart ? '' : 'rg-start-muted'}}"
        bindtap="doStart"
        disabled="{{opBusy}}"
      >开始互动</button>
    </block>

    <view class="rg-room-card rg-guest-wait" wx:if="{{inWaiting && view && !view.isHost}}">
      <view class="text-body muted">👥 等待组长开始互动，可先邀请更多朋友进组</view>
      <button class="btn-wechat-invite" open-type="share" style="margin-top: var(--space-md)">邀请朋友</button>
    </view>

    <view
      class="rg-room-card"
      wx:if="{{view && view.isHost && state && state.currentPhase === 'word' && view.wordProgress}}"
    >
      <view class="text-caption muted">发词已读：{{view.wordProgress.acked}} / {{view.wordProgress.need}}</view>
    </view>
    <view
      class="rg-room-card"
      wx:if="{{view && !view.isAlive && state && state.currentPhase && state.currentPhase !== 'ended'}}"
    >
      <view class="text-body muted">你已暂离本环节，可旁观日志</view>
    </view>

    <view class="uc-panel" wx:if="{{state && state.currentPhase === 'word'}}">
      <button
        class="uc-btn uc-primary"
        wx:if="{{view && view.isAlive && view && view.myWord}}"
        bindtap="openMyWord"
      >看本机词</button>
    </view>

    <view class="uc-panel" wx:if="{{inDiscuss && view && view.isAlive}}">
      <view
        class="uc-h2"
        wx:if="{{view && view.amSpeaking}}"
        style="color: #b45309"
      >轮到你描述</view>
      <view class="uc-muted" wx:elif="{{state && state.speakOrder && state.speakOrder.length}}">本侧描述：下一位等组长切</view>
      <button
        class="uc-btn uc-ghost btn-ai {{aiUnlock.canAssist ? '' : 'ai-locked'}}"
        style="margin-top: 16rpx"
        bindtap="doAgentAssist"
        disabled="{{aiBusy || agentBusy}}"
      >AI 策略建议{{aiUnlock.canAssist ? '' : ' 🔒'}}</button>
    </view>

    <view class="uc-panel" wx:if="{{view && view.isHost && state && state.currentPhase === 'word'}}">
      <button
        class="uc-btn uc-primary"
        bindtap="hDiscuss"
        wx:if="{{view && view.wordProgress && view.wordProgress.acked === view.wordProgress.need}}"
      >进入讨论</button>
    </view>

    <view
      class="uc-panel"
      wx:if="{{view && view.isHost && state && state.currentPhase === 'discuss'}}"
    >
      <button class="uc-btn uc-primary" bindtap="hNext" style="margin-top: 8rpx">下一位发言</button>
      <button class="uc-btn uc-ghost" style="margin-top: 8rpx" bindtap="hStartVote">发起投票</button>
    </view>

    <view class="uc-panel" wx:if="{{inVote}}">
      <view class="uc-h2">投票</view>
      <view class="uc-muted" wx:if="{{state && state.voteProgress}}">已投 {{state.voteProgress.cast}} / {{state.voteProgress.need}}</view>
      <view wx:if="{{view && view.isAlive && !view.hasVoted && voteList && voteList.length}}">
        <button
          class="uc-mopt"
          wx:for="{{voteList}}"
          wx:for-item="t"
          wx:key="openId"
          data-oid="{{t.openId}}"
          bindtap="onVotePick"
        >{{t.nickName}}</button>
        <button class="uc-btn uc-primary" style="margin-top: 8rpx" bindtap="submitMyVote">确定投票</button>
      </view>
      <view class="uc-muted" wx:if="{{view && view.hasVoted && view.isAlive}}">你已完成投票</view>
      <button
        class="uc-btn uc-ghost btn-ai"
        style="margin-top: 16rpx"
        wx:if="{{view && view.isAlive}}"
        bindtap="doAgentAssist"
        disabled="{{aiBusy || agentBusy}}"
      >AI 策略建议</button>
    </view>

    <view class="uc-panel" wx:if="{{view && view.isHost && inVote}}">
      <button
        class="uc-btn uc-primary"
        bindtap="hEndVote"
        wx:if="{{state && state.voteProgress && state.voteProgress.cast === state.voteProgress.need && state.voteProgress.need > 0}}"
      >结票</button>
      <button
        class="uc-btn uc-ghost"
        wx:if="{{inVoteTie && view && view.isHost}}"
        style="margin-top: 8rpx"
        bindtap="hTieRetry"
      >清票重投（同平票时）</button>
    </view>

    <view class="uc-panel" wx:if="{{state && state.currentPhase === 'ended'}}">
      <view class="uc-end" wx:if="{{state && state.winSide === 'good'}}">本环节：普通词侧描述收束</view>
      <view class="uc-end" wx:elif="{{state && state.winSide === 'bad'}}">本环节：持不同词侧收束</view>
      <button class="uc-btn uc-ghost btn-ai {{aiUnlock.canRecap ? '' : 'ai-locked'}}" bindtap="doAiRecap" disabled="{{aiBusy}}">AI 战报文案{{aiUnlock.canRecap ? '' : ' 🔒'}}</button>
      <button class="uc-btn uc-ghost btn-ai {{aiUnlock.canRecap ? '' : 'ai-locked'}}" bindtap="doAgentRecap" disabled="{{aiBusy || agentBusy}}">智能战报{{aiUnlock.canRecap ? '' : ' 🔒'}}</button>
      <button class="uc-btn uc-ghost btn-ai {{aiUnlock.canAssist ? '' : 'ai-locked'}}" bindtap="doAgentAssist" disabled="{{aiBusy || agentBusy}}">AI 策略建议{{aiUnlock.canAssist ? '' : ' 🔒'}}</button>
      <button class="uc-btn uc-ghost btn-ai {{aiUnlock.canRecap ? '' : 'ai-locked'}}" bindtap="doAiPoster" disabled="{{aiBusy}}">生成海报{{aiUnlock.canRecap ? '' : ' 🔒'}}</button>
    </view>

    <view class="uc-log" wx:if="{{logText}}">
      <view class="uc-h2" style="font-size: 28rpx">日志</view>
      <text>{{logText}}</text>
    </view>

    <view
      class="uc-panel"
      wx:if="{{view && view.isHost && state && state.currentPhase && state.currentPhase !== 'waiting' && state.currentPhase !== 'word'}}"
    >
      <block wx:if="{{hostRoles && hostRoles.length}}">
        <view class="uc-h2" style="font-size: 24rpx">看牌（仅组长）</view>
        <view
          class="uc-muted"
          style="font-size: 24rpx"
          wx:for="{{hostRoles}}"
          wx:for-item="g"
          wx:key="o"
        >{{g.n}}: {{g.r === 'undercover' ? '卧底' : '平民'}}{{!g.dead ? '' : ' 出局'}}</view>
      </block>
    </view>

    <view class="uc-mask" wx:if="{{showWord && view && view.myWord}}" catchtouchmove="onMask">
      <view class="uc-modal">
        <view class="uc-h2">本机词</view>
        <view class="uc-secr">{{rzh || (view && view.myRole)}}</view>
        <view class="uc-secr">{{(view && view.myWord) || '—'}}</view>
        <button class="uc-btn uc-primary" bindtap="doAckWord" style="margin-top: 24rpx">我知道了</button>
      </view>
    </view>
  </view>
</block>

<ai-share-modal
  visible="{{showAiShareModal}}"
  next-hint="{{aiUnlock.nextHint || ''}}"
  share-copy="{{shareCopy}}"
  bind:close="onCloseAiShareModal"
  bind:timeline="onAiShareTimeline"
/>
