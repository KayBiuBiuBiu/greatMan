<view class="page">
  <view class="h1" wx:if="{{!roomId}}">🎨 你画我猜</view>
  <view class="hint" wx:if="{{!roomId}}">线下团建纸笔类辅助，同场同步：一人画、全员看画布并抢答。无广域联机。</view>
  <view class="card" wx:if="{{!roomId}}">
    <view class="lab">昵称</view>
    <input class="inp" value="{{nick}}" bindinput="onNick" />
    <button class="btn primary" bindtap="doCreate">创建聚会组</button>
    <view class="mt">或输入 6 位数字口令（至少 2 人可开始）</view>
    <input class="inp" type="number" value="{{joinCode}}" bindinput="onCode" />
    <button class="btn" bindtap="doJoin">加入互动组</button>
  </view>
  <block wx:else>
    <view class="card top">
      <text class="strong">聚会组口令 {{roomCode || (state && state.roomCode)}}</text>
      <button class="btn-wechat-invite" open-type="share" style="margin-top: 16rpx">邀请朋友</button>
      <view class="rg-status-banner" wx:if="{{statusHint}}">{{statusHint}}</view>
    </view>
    <view class="card" wx:if="{{state}}">
      <view class="rg-members-card" style="margin-top:0;background:transparent;border:none;padding:0">
        <view class="rg-members-head">
          <text class="rg-members-title">成员</text>
          <text class="rg-members-count muted">{{memberCountLine}}</text>
        </view>
        <view class="rg-progress-wrap" wx:if="{{playerProgressPct > 0}}">
          <view class="rg-progress-bar"><view class="rg-progress-fill" style="width: {{playerProgressPct}}%;"></view></view>
        </view>
        <view class="muted" wx:if="{{!displayPlayers || !displayPlayers.length}}">暂无成员，请分享口令邀请加入</view>
        <view class="rg-member-list">
          <view class="rg-member-item" wx:for="{{displayPlayers}}" wx:for-item="p" wx:key="openId">
            <view class="rg-avatar">{{p.avatarText}}</view>
            <view class="rg-member-body">
              <view class="rg-member-name-row">
                <text class="rg-member-name">{{p.nickName}}</text>
                <text class="rg-host-badge" wx:if="{{p.isHost}}">👑</text>
                <view class="rg-ready-dot {{p.ready ? 'on' : ''}}"></view>
              </view>
              <text class="rg-ready-label">{{p.score != null ? p.score + ' 分 · ' : ''}}{{p.readyLabel}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="card" wx:if="{{state && state.status === 'waiting' && view && view.isHost}}">
      <view class="rg-section" style="margin-top:0">
        <view class="rg-section-label">总轮数</view>
        <picker range="{{roundOptions}}" value="{{roundIdx}}" bindchange="onRoundPick">
          <view class="pill">{{roundOptions[roundIdx] || '6 轮'}}</view>
        </picker>
      </view>
      <view class="rg-section">
        <view class="rg-section-label">题目来源</view>
        <view class="rg-seg-row">
          <view class="rg-seg {{wordSource === 'system' ? 'active' : ''}}" data-src="system" bindtap="onWordSourceTap">系统词库</view>
          <view class="rg-seg {{wordSource === 'ai' ? 'active' : ''}}" data-src="ai" bindtap="onWordSourceTap">AI 题目</view>
        </view>
        <view class="rg-preview-card" wx:if="{{wordSource === 'ai' && aiPendingWord}}">
          <view class="rg-preview-title">已生成题目（预览）</view>
          <view class="rg-preview-words">《{{aiPendingWord}}》</view>
        </view>
        <view class="lab mt">词库风格（系统随机时生效）</view>
        <picker range="{{catNames}}" value="{{catIdx}}" bindchange="onCatPick">
          <view class="pill">{{catNames[catIdx]}}</view>
        </picker>
        <view class="rg-tip">修改轮数/词库后自动保存</view>
      </view>
      <view class="rg-ai-panel">
        <view class="rg-ai-panel-head" bindtap="toggleAiPanel">
          <text>🤖 AI 辅助</text>
          <text class="rg-ai-chevron">{{aiPanelOpen ? '▲' : '▼'}}</text>
        </view>
        <view class="rg-ai-panel-body" wx:if="{{aiPanelOpen}}">
          <button class="btn btn-ai rg-btn-ghost {{aiUnlock.canGen ? '' : 'ai-locked'}}" bindtap="doAiWord" disabled="{{aiBusy}}">✨ AI 生成题目{{aiUnlock.canGen ? '' : ' 🔒'}}</button>
          <view class="rg-tip">仅生成预览，点「开始互动」后使用</view>
        </view>
      </view>
      <button class="rg-btn-primary" bindtap="doStart">开始互动</button>
    </view>
    <view class="card" wx:if="{{(state && state.status) === 'playing' || (state && state.status) === 'finished'}}">
      <view class="row" wx:if="{{(state && state.currentRound) > 0 || (view && view.myScore != null)}}">
        <text>第 {{(state && state.currentRound) || 0}} / {{state && state.totalRounds}} 轮</text>
        <text wx:if="{{view && view.myScore != null}}">我 {{view.myScore}} 分</text>
        <view class="pill" wx:if="{{(state && state.phase) === 'drawing'}}">⏱ {{timeLeft}}s</view>
      </view>
      <view class="row" wx:if="{{state && state.currentDrawerNick}}">绘画：{{state && state.currentDrawerNick}}</view>
    </view>
    <view
      class="word-big"
      wx:if="{{view && view.isDrawer && (state && state.phase) === 'drawing' && view.painterWord}}"
    >画：{{view.painterWord}}
    </view>
    <view
      class="card draw-wrap"
      wx:if="{{view && view.isDrawer && (state && state.phase) === 'drawing' }}"
    >
      <canvas
        class="cvs"
        type="2d"
        id="cvs2"
        bindtouchstart="onTouchS"
        bindtouchmove="onTouchM"
        bindtouchend="onTouchE"
      />
      <view class="row tools">
        <button size="mini" class="tbtn" data-c="#111" bindtap="onPickColor">黑</button>
        <button size="mini" class="tbtn" data-c="#d33" bindtap="onPickColor">红</button>
        <button size="mini" class="tbtn" data-c="#16a" bindtap="onPickColor">蓝</button>
        <button size="mini" class="tbtn" bindtap="onClear">清空</button>
        <text class="tlab">线宽</text>
        <slider
          class="sli"
          min="2"
          max="10"
          value="{{lineW}}"
          bindchange="onLineW"
        />
      </view>
    </view>
    <view
      class="card"
      wx:if="{{view && !view.isDrawer && (state && state.status) === 'playing' && (state && state.phase) === 'drawing'}}"
    >
      <view class="lab">Ta 的画</view>
      <view class="remote-wrap" wx:if="{{remoteCanvasSrc}}">
        <image class="remote" mode="widthFix" src="{{remoteCanvasSrc}}"></image>
      </view>
      <view class="noimg" wx:else>等绘画者开画…</view>
    </view>
    <view
      class="card"
      wx:if="{{(state && state.status) === 'playing' && (state && state.phase) === 'drawing' && !view.isDrawer && view && !view.hasGuessedThisRound }}"
    >
      <input
        class="inp"
        placeholder="猜是什么词"
        value="{{guessInput}}"
        bindinput="onGuessI"
      />
      <button class="btn primary" size="mini" bindtap="doSubmitGuess">提交</button>
    </view>
    <view
      class="ok"
      wx:if="{{(state && state.phase) === 'drawing' && !view.isDrawer && view && view.hasGuessedThisRound }}"
    >本 轮已答</view>
    <view class="card" wx:if="{{(state && state.phase) === 'revealed' || (state && state.status) === 'finished'}}">
      <view class="h2" wx:if="{{(state && state.revealedWord) || (view && view.revealedWord) }}">答案</view>
      <view
        class="ans"
        wx:if="{{(state && state.revealedWord) || (view && view.revealedWord) }}"
      >《{{(state && state.revealedWord) || (view && view.revealedWord) }}》
      </view>
      <view
        class="hits"
        wx:if="{{state && state.roundHits && state.roundHits.length > 0}}"
      >
        <view wx:for="{{state.roundHits}}" wx:key="openId">{{item.nickName}} +{{item.points}}</view>
      </view>
    </view>
    <view class="card" wx:if="{{(view && view.isHost) && (state && state.status) === 'playing' }}">
      <button class="btn" size="mini" wx:if="{{(state && state.phase) === 'drawing' }}" bindtap="doReveal">揭晓答案</button>
      <button class="btn" size="mini" wx:if="{{(state && state.phase) === 'drawing' }}" bindtap="doSkip">换词</button>
      <button class="btn" size="mini" wx:if="{{(state && state.phase) === 'revealed' }}" bindtap="doNextR">下一轮</button>
      <button class="btn" size="mini" bindtap="doEndG">结束本环节</button>
    </view>
    <view
      class="card"
      wx:if="{{(state && state.status) === 'finished' || (view && view.roomStatus) === 'finished'}}"
    >
      <view class="h2">本环节得分（同场参考）</view>
      <view
        class="rank"
        wx:for="{{(state && state.publicPlayers) || (view && view.publicPlayers) || []}}"
        wx:for-item="u"
        wx:for-index="i"
        wx:key="openId"
      >{{i + 1}}. {{u.nickName}} — {{u.score}} 分</view>
    </view>
    <view class="card" wx:if="{{state && state.publicLog && state.publicLog.length > 0}}">
      <view class="h2">记录</view>
      <view class="log" wx:for="{{state && state.publicLog}}" wx:key="*this">{{item}}</view>
    </view>
  </block>
</view>

<ai-share-modal
  visible="{{showAiShareModal}}"
  next-hint="{{aiUnlock.nextHint || ''}}"
  share-copy="{{shareCopy}}"
  bind:close="onCloseAiShareModal"
  bind:timeline="onAiShareTimeline"
/>
