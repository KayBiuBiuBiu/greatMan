@import '../../styles/room-game.wxss';

.page {
  min-height: 100vh;
  background: #fef8f0;
  padding: 28rpx 24rpx 64rpx;
  box-sizing: border-box;
}

.h1 {
  font-size: 44rpx;
  font-weight: 800;
  color: #23212a;
}

.hint,
.wait {
  font-size: 26rpx;
  color: #5f5966;
  margin: 16rpx 0 24rpx;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.top {
  text-align: center;
}

.strong {
  color: #ff7a2f;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.h2 {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: #1f1c24;
}

.lab,
.row {
  font-size: 28rpx;
  color: #4b4652;
  margin: 6rpx 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.mt {
  margin-top: 20rpx;
}

.mem {
  font-size: 28rpx;
  color: #333;
  padding: 4rpx 0;
}

.pill {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #fff0e0;
  color: #8a3a0a;
  font-weight: 600;
}

.inp {
  min-height: 80rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f3f0f5;
  margin: 12rpx 0;
  width: 100%;
  box-sizing: border-box;
  font-size: 30rpx;
}

.btn,
button.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx 0;
  min-height: 76rpx;
  padding: 0 24rpx;
  line-height: 1.35;
  border-radius: 16rpx;
  background: #ece8e3;
  font-size: 28rpx;
  box-sizing: border-box;
}
.btn::after {
  border: none;
}

.btn.primary {
  background: linear-gradient(90deg, #ff9a4a, #ff7a2f);
  color: #fff;
  font-weight: 600;
}

.draw-wrap {
  position: relative;
  overflow: hidden;
  border: 1rpx solid #e8e4de;
  border-radius: 16rpx;
  background: #faf7ff;
}

.cvs {
  width: 280px;
  height: 400px;
  display: block;
  touch-action: none;
  margin: 0 auto;
}

.tools {
  flex-wrap: wrap;
  margin-top: 8rpx;
  gap: 8rpx;
}

.tbtn {
  margin: 0 4rpx;
}

.sli {
  width: 180rpx;
  margin-left: 8rpx;
  flex: 1;
  min-width: 120rpx;
}

.tlab {
  font-size: 24rpx;
  color: #6b6470;
}

.word-big {
  font-size: 40rpx;
  font-weight: 900;
  color: #1a6;
  text-align: center;
  margin: 12rpx 0 8rpx;
  padding: 0 8rpx;
  line-height: 1.4;
}

.remote-wrap {
  min-height: 200rpx;
  text-align: center;
  background: #faf7ff;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #eee5ff;
}

.remote {
  max-width: 100%;
  vertical-align: top;
  display: block;
  margin: 0 auto;
}

.noimg {
  min-height: 200rpx;
  line-height: 200rpx;
  text-align: center;
  color: #9a93a0;
  font-size: 26rpx;
}

.ans {
  font-size: 40rpx;
  font-weight: 800;
  color: #15803d;
  text-align: center;
  margin: 12rpx 0;
}

.hits {
  font-size: 26rpx;
  color: #166534;
  margin-top: 8rpx;
}

.log {
  font-size: 24rpx;
  color: #6b6470;
  line-height: 1.5;
  padding: 2rpx 0;
  word-break: break-all;
}

.ok {
  color: #166534;
  text-align: center;
  font-size: 28rpx;
  margin: 8rpx 0 16rpx;
}

.rank {
  font-size: 30rpx;
  line-height: 1.5;
  padding: 4rpx 0;
  border-bottom: 1rpx solid #f0ebe5;
  color: #1f1c24;
}

.rank:last-child {
  border-bottom: none;
}
