@import '../../styles/room-game.wxss';

/* 页面沿用 app.wxss .page 安全边距；仅补充画猜专属 */
.draw-page-inroom {
  padding-bottom: calc(var(--page-pad-bottom) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--page-pad-bottom) + env(safe-area-inset-bottom));
}

.draw-lobby-hero {
  margin-bottom: var(--space-md);
}

.draw-lobby-hero-compact {
  margin-bottom: var(--space-sm);
}

.draw-lobby-hero-compact .hero-title {
  font-size: var(--font-title-size);
  line-height: var(--font-title-lh);
}

.draw-label,
.rg-lobby-label {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-accent);
  margin-bottom: var(--space-xs);
}

.draw-inp,
.rg-lobby-inp {
  min-height: var(--btn-secondary-height);
  padding: 0 var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-muted);
  margin: var(--space-sm) 0;
  width: 100%;
  box-sizing: border-box;
  font-size: var(--font-body-size);
}

.draw-members-inner {
  margin-top: 0;
}

.draw-empty-members {
  text-align: center;
  padding: var(--space-sm) 0;
  color: var(--color-text-secondary);
}

.draw-guest-wait {
  text-align: center;
}

.draw-play-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.draw-host-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.draw-host-actions .btn {
  flex: 1;
  min-width: 140rpx;
}

.row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs);
}

.draw-wrap {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: #faf7ff;
}

.cvs {
  width: 280px;
  height: 400px;
  display: block;
  touch-action: none;
  margin: 0 auto;
}

.tools {
  margin-top: var(--space-sm);
}

.tbtn {
  margin: 0 4rpx;
}

.sli {
  width: 180rpx;
  margin-left: var(--space-xs);
  flex: 1;
  min-width: 120rpx;
}

.tlab {
  color: var(--color-text-secondary);
}

.word-big {
  font-size: var(--font-title-size);
  line-height: var(--font-title-lh);
  font-weight: var(--font-weight-semibold);
  color: #15803d;
  text-align: center;
  margin: var(--space-sm) 0;
  padding: 0 var(--space-xs);
}

.remote-wrap {
  min-height: 200rpx;
  text-align: center;
  background: #faf7ff;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1rpx solid var(--color-border-soft);
}

.remote {
  max-width: 100%;
  display: block;
  margin: 0 auto;
}

.noimg {
  min-height: 200rpx;
  line-height: 200rpx;
  text-align: center;
  color: var(--color-text-secondary);
}

.ans {
  font-size: var(--font-title-size);
  line-height: var(--font-title-lh);
  font-weight: var(--font-weight-medium);
  color: #15803d;
  text-align: center;
  margin: var(--space-sm) 0;
}

.hits {
  color: #166534;
  margin-top: var(--space-xs);
}

.log {
  line-height: 1.5;
  padding: 2rpx 0;
  word-break: break-all;
  color: var(--color-text-secondary);
}

.ok {
  text-align: center;
  margin: var(--space-sm) 0 var(--space-md);
}

.rank {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  padding: var(--space-xs) 0;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text);
}

.rank:last-child {
  border-bottom: none;
}
