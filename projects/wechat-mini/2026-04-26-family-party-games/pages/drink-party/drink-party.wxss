@import '../../styles/room-game.wxss';

.dp-page-inroom {
  padding-bottom: calc(var(--page-pad-bottom) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--page-pad-bottom) + env(safe-area-inset-bottom));
}

.dp-hero-compact {
  margin-bottom: var(--space-md);
}

.dp-hero-compact .hero-title {
  font-size: var(--font-title-size);
  line-height: var(--font-title-lh);
}

.dp-card {
  margin-bottom: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.dp-label {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-accent);
  margin-bottom: var(--space-xs);
}

.dp-inp {
  width: 100%;
  min-height: var(--btn-secondary-height);
  padding: 0 var(--space-md);
  margin: var(--space-sm) 0 0;
  border-radius: var(--radius-md);
  background: var(--color-bg-muted);
  box-sizing: border-box;
  font-size: var(--font-body-size);
  color: var(--color-text);
}

.dp-host-name {
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--color-border);
}

.dp-ghost {
  text-align: center;
  color: var(--color-text-accent);
  font-size: var(--font-body-size);
  font-weight: var(--font-weight-medium);
  margin-top: var(--space-sm);
  padding: var(--space-xs);
}

.dp-members-inner {
  margin-top: var(--space-md);
  padding: 0;
  background: transparent;
  border: none;
}

.dp-vote-progress-text {
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  text-align: center;
}

.dp-member-votable:active {
  opacity: 0.85;
  transform: scale(0.99);
}

.dp-member-picked {
  border-color: var(--color-brand) !important;
  background: #fff7ed !important;
  box-shadow: 0 0 0 2rpx rgba(255, 122, 47, 0.25);
}

.dp-vote-check {
  font-size: var(--font-caption-size);
  color: var(--color-success);
  font-weight: var(--font-weight-semibold);
}

.dp-main-btn {
  margin-top: var(--space-lg);
  margin-bottom: var(--space-xl);
}

/* ---------- 倒计时 ---------- */
.dp-phase-card {
  text-align: center;
}

.dp-countdown-num {
  font-size: 120rpx;
  line-height: 1.1;
  font-weight: var(--font-weight-semibold);
  color: var(--color-brand);
  margin: var(--space-xl) 0 var(--space-sm);
  text-shadow: 0 8rpx 28rpx rgba(255, 122, 47, 0.2);
}

.dp-countdown-sub {
  color: var(--color-text-secondary);
  margin-bottom: var(--space-sm);
}

.dp-countdown-tip {
  color: var(--color-text-secondary);
  padding-bottom: var(--space-md);
}

/* ---------- 投票 ---------- */
.dp-phase-title {
  text-align: left;
  margin-bottom: var(--space-sm);
}

.dp-sub-tip {
  text-align: left;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-secondary-bg);
  color: var(--color-text-secondary);
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  margin-bottom: var(--space-md);
}

.dp-ringer-hint {
  text-align: center;
  color: var(--color-brand);
  font-size: var(--font-card-title-size);
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--space-sm);
}

.dp-vote-timer {
  text-align: center;
  margin-bottom: var(--space-md);
  color: var(--color-text);
}

.dp-em {
  color: var(--color-brand-deep);
  font-weight: var(--font-weight-medium);
}

.dp-vote-done-tip {
  text-align: center;
  margin: var(--space-md) 0;
}

.dp-vote-actions {
  margin-top: var(--space-sm);
}

.dp-force-btn {
  margin-top: var(--space-md);
}

/* ---------- 结果 + AI ---------- */
.dp-result-line {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
  text-align: left;
}

.dp-bignum {
  color: var(--color-brand);
  font-size: var(--font-title-size);
  font-weight: var(--font-weight-semibold);
  margin: 0 4rpx;
}

.dp-result-wrong {
  margin-top: var(--space-md);
  color: var(--color-text-secondary);
  text-align: left;
}

.dp-ai-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.dp-ai-row .btn-ai {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 80rpx;
  padding: 0 var(--space-md);
  box-sizing: border-box;
  background: linear-gradient(135deg, #a855f7, #7c3aed) !important;
  color: var(--color-text-inverse) !important;
  border-radius: var(--radius-lg);
  font-size: var(--font-body-size);
  font-weight: var(--font-weight-medium);
  border: none;
  line-height: var(--font-body-lh);
}

.dp-ai-row .btn-ai::after {
  border: none;
}

.dp-ai-row .btn-ai.ai-locked {
  opacity: 0.6;
}
