<!-- 未进房 -->
<view class="page dp-page" wx:if="{{!roomId}}">
  <view class="hero">
    <view class="hero-title">趣味抽签</view>
    <view class="hero-subtitle">随机抽签：倒计时、响铃、投票与趣味小任务。凭 6 位数字口令进组；至少 2 人可开始。</view>
  </view>
  <view class="dp-card">
    <view class="dp-label">昵称</view>
    <input class="dp-inp" placeholder="输入昵称" value="{{nick}}" bindinput="onNick" />
    <button class="btn btn-primary main-btn" bindtap="doCreate" disabled="{{opBusy}}">创建聚会组</button>
  </view>
  <view class="dp-card">
    <view class="dp-label">已有口令</view>
    <input class="dp-inp" type="number" maxlength="6" placeholder="6 位数字" value="{{joinCode}}" bindinput="onCode" />
    <button class="btn btn-secondary main-btn" bindtap="doJoin" disabled="{{opBusy}}">加入互动组</button>
  </view>
</view>

<!-- 已进房 -->
<view class="page dp-page dp-page-inroom" wx:else>
  <view class="hero dp-hero-compact">
    <view class="hero-title">趣味抽签</view>
    <view class="hero-subtitle text-caption" wx:if="{{state}}">
      {{state.roomName || '聚会组'}} · 第 {{roundDisp}} 轮
    </view>
    <view class="hero-subtitle text-caption" wx:else>加载中…</view>
  </view>

  <!-- 口令 + 邀请 -->
  <view class="dp-card" wx:if="{{state}}">
    <view class="rg-code-row">
      <view class="rg-code-main">
        <text class="rg-code-label">聚会组口令</text>
        <view class="rg-code-num-row rg-code-tap" bindtap="onCopyRoomCode">
          <text class="rg-code-num">{{state.roomCode}}</text>
        </view>
      </view>
      <button class="btn-wechat-invite rg-invite-btn" open-type="share">邀请朋友</button>
    </view>
    <view class="dp-host-name" wx:if="{{isHost}}">
      <view class="dp-label">组名（仅组长）</view>
      <input class="dp-inp" value="{{roomNameEdit}}" bindinput="onRoomName" confirm-type="done" />
      <view class="dp-ghost" bindtap="onSaveRoomName">保存组名</view>
    </view>
  </view>

  <!-- 状态 + 成员 -->
  <view class="dp-card" wx:if="{{state}}">
    <view
      class="rg-status-banner {{statusBannerWarn ? 'rg-banner-warn' : ''}}"
      wx:if="{{phaseHint}}"
    >{{phaseHint}}</view>

    <view class="rg-members-card dp-members-inner">
      <view class="rg-members-head">
        <text class="rg-members-title">成员</text>
        <text class="rg-members-count muted">{{memberCountLine}}</text>
      </view>
      <view class="rg-progress-wrap" wx:if="{{state.phase === 'voting' && voteProgressNeed > 0}}">
        <view class="rg-progress-bar">
          <view class="rg-progress-fill" style="width: {{voteProgressPct}}%;"></view>
        </view>
        <view class="dp-vote-progress-text text-caption">
          已投票 {{voteProgressCast}} / {{voteProgressNeed}}
        </view>
      </view>
      <view class="rg-progress-wrap" wx:elif="{{inWaiting}}">
        <view class="rg-progress-bar">
          <view class="rg-progress-fill" style="width: {{playerProgressPct}}%;"></view>
        </view>
      </view>
      <view class="rg-member-list">
        <view
          class="rg-member-item {{state.phase === 'voting' && !voteDone ? 'dp-member-votable' : ''}} {{pick === p.openId ? 'dp-member-picked' : ''}}"
          wx:for="{{displayPlayers}}"
          wx:for-item="p"
          wx:key="openId"
          data-oid="{{p.openId}}"
          bindtap="onMemberVoteTap"
        >
          <view class="rg-avatar">{{p.avatarText}}</view>
          <view class="rg-member-body">
            <view class="rg-member-name-row">
              <text class="rg-member-name">{{p.nickName}}</text>
              <text class="rg-host-badge" wx:if="{{p.isHost}}">👑</text>
              <text class="dp-vote-check" wx:if="{{p.hasVoted}}">✓</text>
              <view class="rg-ready-dot {{p.ready ? 'on' : ''}}" wx:if="{{state.phase !== 'voting'}}"></view>
            </view>
            <text class="rg-ready-label">{{p.readyLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 等待 -->
  <button
    class="rg-btn-primary main-btn dp-main-btn {{canStart ? '' : 'rg-start-muted'}}"
    wx:if="{{isHost && state && state.phase === 'waiting'}}"
    bindtap="onStart"
    disabled="{{opBusy}}"
  >开始本轮</button>

  <!-- 倒计时 -->
  <view class="dp-card dp-phase-card" wx:if="{{state && state.phase === 'countdown'}}">
    <view class="dp-countdown-num">{{cdLabel}}</view>
    <view class="dp-countdown-sub text-caption">响铃者即将揭晓</view>
    <view class="dp-countdown-tip text-caption">结束后随机一名参与者本机短震提示</view>
  </view>

  <!-- 投票 -->
  <view class="dp-card dp-phase-card" wx:if="{{state && state.phase === 'voting'}}">
    <view class="text-card-title dp-phase-title">{{state.targetNick || '—'}} 的手机「响了」</view>
    <view class="dp-sub-tip">
      30 秒内每人选 1 人。投给响铃者：响铃者记票；投给非响铃者：自领 1 次趣味小任务。点击成员即可投票，也可弃权。
    </view>
    <view class="dp-ringer-hint" wx:if="{{iAmRinger}}">你是响铃者，本机已短震</view>
    <view class="dp-vote-timer text-body" wx:if="{{deadLeftS >= 0}}">
      投票剩余约 <text class="dp-em">{{deadLeftS}}</text> 秒
    </view>
    <view class="dp-vote-done-tip text-success" wx:if="{{voteDone}}">你已投票（本轮不可改）</view>
    <view class="dp-vote-actions" wx:if="{{!voteDone}}">
      <button class="btn btn-secondary main-btn btn-md" bindtap="onAbstain" disabled="{{opBusy}}">弃权</button>
    </view>
    <button
      class="btn btn-secondary main-btn btn-md dp-force-btn"
      wx:if="{{isHost && state.voteProgress && state.voteProgress.cast < state.voteProgress.need}}"
      bindtap="onForceEnd"
      disabled="{{opBusy}}"
    >强制结束投票</button>
  </view>

  <!-- 结果 -->
  <view class="dp-card dp-phase-card" wx:if="{{state && state.phase === 'result' && state.result}}">
    <view class="dp-result-line">
      响铃者：<text class="dp-em">{{state.result.targetNick}}</text> 得
      <text class="dp-em">{{state.result.targetSips}}</text> 票，需完成
      <text class="dp-bignum">{{state.result.targetSips}}</text> 次趣味小任务
    </view>
    <view class="dp-result-wrong text-caption" wx:if="{{state.result.wrongVoters && state.result.wrongVoters.length}}">
      投错需小任务：{{wrongNames}}
    </view>
    <view class="dp-result-wrong text-caption" wx:else>无投错，无人因「投错」多领 1 次小任务</view>

    <view class="dp-ai-row">
      <button
        wx:if="{{aiUnlock.canGen}}"
        class="btn-ai"
        bindtap="onAiCommentResult"
        disabled="{{aiBusy}}"
      >✨ AI 解说</button>
      <button wx:else class="btn-ai ai-locked" bindtap="onAiUnlockTap">🔒 AI 解说</button>
      <button
        wx:if="{{aiUnlock.canGen}}"
        class="btn-ai"
        bindtap="onAiFunTask"
        disabled="{{aiBusy}}"
      >✨ AI 趣味任务</button>
      <button wx:else class="btn-ai ai-locked" bindtap="onAiUnlockTap">🔒 AI 趣味任务</button>
    </view>
  </view>

  <button
    class="rg-btn-primary main-btn dp-main-btn"
    wx:if="{{isHost && state && state.phase === 'result'}}"
    bindtap="onNextRound"
    disabled="{{opBusy}}"
  >下一轮</button>
</view>

<ai-share-modal
  visible="{{showAiShareModal}}"
  next-hint="{{aiUnlock.nextHint || ''}}"
  share-copy="{{shareCopy}}"
  bind:close="onCloseAiShareModal"
  bind:timeline="onAiShareTimeline"
/>
