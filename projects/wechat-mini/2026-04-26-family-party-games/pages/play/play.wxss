.tabs {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0;
  line-height: normal;
}

.prompt-card,
.score-card,
.timer-card {
  margin-top: 26rpx;
  padding: 34rpx;
}

.prompt-title {
  color: #23212a;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.35;
}

.prompt-detail {
  margin-top: 24rpx;
  color: #5f5966;
  font-size: 30rpx;
  line-height: 1.7;
}

.hint,
.answer {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  color: #8a3a0a;
  background: #fff4e8;
  font-size: 26rpx;
  line-height: 1.5;
}

.main-btn {
  margin-top: 24rpx;
  min-height: 78rpx;
}

.compact {
  margin: 0 0 18rpx;
}

.score-row {
  display: flex;
  gap: 12rpx;
}

.score-btn {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0;
  font-size: 24rpx;
}

.score-text {
  margin-top: 22rpx;
  color: #7b7280;
  font-size: 28rpx;
}

.timer-number {
  color: #FF7A2F;
  font-size: 72rpx;
  font-weight: 900;
  text-align: center;
}

/* 同场同步真心话大冒险 */
.td-card {
  margin-top: 22rpx;
  padding: 32rpx;
  border-radius: 36rpx;
}

.td-block {
  margin-top: 8rpx;
}

.td-lead {
  color: #5f5966;
  font-size: 28rpx;
  line-height: 1.65;
  margin-bottom: 20rpx;
}

.td-code {
  margin: 16rpx 0;
  font-size: 30rpx;
  color: #23212a;
}

.td-em {
  color: #c2410c;
  font-weight: 900;
}

.td-boom {
  text-align: center;
  color: #f97316;
  font-size: 34rpx;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.td-egg-label {
  text-align: center;
  color: #7b7280;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.td-name {
  text-align: center;
  font-size: 52rpx;
  font-weight: 900;
  color: #23212a;
  margin-bottom: 20rpx;
}

.td-tip {
  color: #5f5966;
  font-size: 28rpx;
  line-height: 1.55;
  margin: 16rpx 0;
}

.td-tip.warn {
  color: #b91c1c;
  background: #fef2f2;
  padding: 20rpx;
  border-radius: 20rpx;
}

.td-tip.ok {
  color: #15803d;
}

.td-tally {
  text-align: center;
  color: #7b7280;
  font-size: 26rpx;
  margin: 8rpx 0 20rpx;
}

.td-vote-btns {
  display: flex;
  gap: 20rpx;
  margin: 8rpx 0 8rpx;
}

.td-half {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  margin: 0 !important;
  padding: 0 !important;
  font-size: 32rpx;
  font-weight: 800;
}

.td-curse {
  color: #b91c1c;
  background: #fff1f2;
  padding: 32rpx 24rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  font-weight: 700;
  margin: 16rpx 0 24rpx;
}

.td-curse.egg-body {
  white-space: pre-wrap;
  font-size: 28rpx;
}

.td-q-title {
  color: #23212a;
  font-size: 40rpx;
  font-weight: 900;
  margin: 20rpx 0 8rpx;
}

.td-q-detail {
  color: #5f5966;
  font-size: 32rpx;
  line-height: 1.65;
  margin-bottom: 20rpx;
}

.muted.sm {
  font-size: 24rpx;
  margin: 8rpx 0 20rpx;
  line-height: 1.5;
}
