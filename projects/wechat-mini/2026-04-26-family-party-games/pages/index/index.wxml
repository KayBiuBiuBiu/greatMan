<view class="page index-page">
  <view class="hero">
    <view class="hero-title">家庭聚会助手</view>
    <view class="hero-sub">亲友聚会互动</view>
    <view class="hero-subtitle">
      <view class="hero-subtitle-line">把口令发给亲友，各自手机进同一组</view>
    </view>
    <button class="join-btn btn btn-secondary" bindtap="joinRoom">输入口令</button>
    <button
      class="join-btn btn btn-secondary {{aiUnlock.canRecap ? '' : 'ai-locked'}}"
      style="margin-top: 28rpx"
      bindtap="onAiRecommend"
      disabled="{{agentBusy}}"
    >AI 聚会建议{{aiUnlock.canRecap ? '' : ' 🔒'}}</button>
  </view>

  <scroll-view class="activity-panel" scroll-y enhanced show-scrollbar>
    <view class="card-grid">
      <view class="item-card card" wx:for="{{games}}" wx:key="title">
        <view class="icon-bubble">{{item.icon}}</view>
        <view class="item-name">{{item.displayTitle}}</view>
        <view class="item-desc">{{item.displaySummary}}</view>
        <view class="card-actions">
          <button
            class="start-btn btn btn-primary"
            bindtap="startGame"
            data-title="{{item.title}}"
            data-screen="{{item.screen}}"
          >开始互动</button>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

<ai-share-modal
  visible="{{showAiShareModal}}"
  next-hint="{{aiUnlock.nextHint || ''}}"
  share-copy="{{shareCopy}}"
  bind:close="onCloseAiShareModal"
  bind:timeline="onAiShareTimeline"
/>
