<view class="page">
  <view class="hero">
    <view class="hero-title">{{title}}</view>
    <view class="hero-subtitle">{{screen==='undercover' ? '创建后得到 6 位数字口令（房号）。至少 3 人且需凑满设定人数；同场发牌、看词、投票。' : screen==='werewolf' ? '创建后得到 6 位数字口令。人齐后选板子人数（6/8/10/12 人局）；把口令发给身边朋友。' : screen==='songGuess' ? '创建后得到 6 位数字口令。建议至少 2 人；每题随机一人本机外放，他人抢答。' : screen==='drinkParty' ? '创建后得到 6 位数字口令。至少 2 人可开始；倒计时、响铃、投票与趣味小任务，同场同步。' : screen==='drawGuess' ? '创建后得到 6 位数字口令。至少 2 人可开始；一人画画，大家同屏猜词。' : '先设置人数，再生成口令开始互动'}}</view>
  </view>

  <view class="card setup-card" wx:if="{{screen === 'songGuess'}}">
    <view class="hint" style="line-height:1.6">创建后得到 6 位数字口令（不是人数）。每题随机一名「主持」在 ta 手机上看歌名（本机外放），其他人只抢答。</view>
  </view>

  <view class="card setup-card" wx:if="{{screen === 'drawGuess'}}">
    <view class="hint" style="line-height:1.6">创建后把 6 位数字口令发给朋友；至少 2 人可开始。组长可设轮数与词库，绘画者仅自己可见题面。</view>
  </view>

  <view class="card setup-card" wx:if="{{screen==='drinkParty'}}">
    <view class="hint" style="line-height:1.6">创建后把 6 位数字口令发给同座；至少 2 人可开始。组长可改组名，同场倒计时、响铃与投票。</view>
  </view>

  <view
    class="card setup-card"
    wx:if="{{screen !== 'songGuess' && screen !== 'drawGuess' && screen!=='drinkParty'}}"
  >
    <block wx:if="{{screen === 'werewolf'}}">
      <view class="rg-setting-item">
        <text class="rg-label">本环节人数</text>
        <view class="rg-stepper-board">
          <view
            class="stepper-btn {{wolfSizeIndex <= 0 ? 'stepper-btn-disabled' : ''}}"
            bindtap="onWolfDecrease"
          >-</view>
          <text class="stepper-value">{{playerCount}}</text>
          <view
            class="stepper-btn {{wolfSizeIndex >= 3 ? 'stepper-btn-disabled' : ''}}"
            bindtap="onWolfIncrease"
          >+</view>
        </view>
      </view>
      <view class="rg-stepper-hint">{{wolfSizeHint}}</view>
    </block>
    <block wx:elif="{{screen === 'undercover'}}">
      <view class="rg-setting-item">
        <text class="rg-label">本环节人数</text>
        <view class="rg-stepper-board">
          <view
            class="stepper-btn {{ucSizeIndex <= 0 ? 'stepper-btn-disabled' : ''}}"
            bindtap="onUcDecrease"
          >-</view>
          <text class="stepper-value">{{playerCount}}</text>
          <view
            class="stepper-btn {{ucSizeIndex >= 11 ? 'stepper-btn-disabled' : ''}}"
            bindtap="onUcIncrease"
          >+</view>
        </view>
      </view>
      <view class="rg-stepper-hint">{{ucSizeHint}}</view>
      <view class="hint" style="margin-top: var(--space-sm)">同场 v2：每环节 1 个不同词，进组后组长可再调人数。</view>
    </block>
    <block wx:else>
      <view class="rg-setting-item">
        <text class="rg-label">本环节人数</text>
        <view class="rg-stepper-board">
          <view class="stepper-btn {{playerCount <= 1 ? 'stepper-btn-disabled' : ''}}" bindtap="onGenericDecrease">-</view>
          <text class="stepper-value">{{playerCount}}</text>
          <view class="stepper-btn {{playerCount >= 20 ? 'stepper-btn-disabled' : ''}}" bindtap="onGenericIncrease">+</view>
        </view>
      </view>
      <view class="rg-stepper-hint">可选 1～20 人</view>
    </block>
  </view>

  <button class="btn btn-primary main-btn" bindtap="createRoom">{{screen==='werewolf' || screen==='undercover' || screen==='songGuess' || screen==='drawGuess' || screen==='drinkParty' ? '创建聚会组并进入' : '生成口令并进入'}}</button>
  <button wx:if="{{screen !== 'undercover' && screen !== 'werewolf' && screen !== 'songGuess' && screen !== 'drawGuess' && screen!=='drinkParty'}}" class="btn btn-secondary main-btn" bindtap="startLocal">本机直接开始互动</button>
</view>
