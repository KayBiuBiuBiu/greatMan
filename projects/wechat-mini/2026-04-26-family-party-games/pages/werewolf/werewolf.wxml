<view class="page">
  <view class="title" style="font-size: 40rpx; margin: 8rpx 0 16rpx">🎭 秘密身份推理（聚会版）</view>
  <view class="muted" style="font-size: 24rpx; margin-bottom: 12rpx">多人身份推理助手，无恐怖元素，家庭亲子友好。把口令发给亲友进组，无陌生匹配。</view>
  <view wx:if="{{!roomId}}" class="panel">
    <view class="muted">同场同步需云开发。先写昵称，再创建或凭 6 位数字口令进组（房号，不是人数）。</view>
    <input
      class="input"
      value="{{nick}}"
      bindinput="onNickIn"
      bindblur="saveNick"
      placeholder="本机昵称"
    />
    <view class="row" style="margin-top: 24rpx">
      <button class="btn btn-primary rg-btn-primary" bindtap="doCreate" disabled="{{opBusy}}">创建聚会组</button>
    </view>
    <view class="muted" style="margin-top: 20rpx">或输入 6 位数字口令加入</view>
    <input class="input" value="{{joinCode}}" bindinput="onCodeIn" type="number" placeholder="6位数字" />
    <view class="row" style="margin-top: 12rpx">
      <button class="btn btn-ghost rg-btn-ghost" bindtap="doJoin" disabled="{{opBusy}}">加入互动组</button>
    </view>
  </view>
  <block wx:else>
    <view class="panel">
      <view class="title">聚会组口令 {{roomCode || (pub && pub.roomCode) || '—'}}</view>
      <button class="btn-wechat-invite" open-type="share" style="margin-top: 16rpx">邀请朋友</button>
      <view class="muted" wx:if="{{!pub}}">正在同步…</view>
      <view class="rg-status-banner" wx:if="{{statusHint}}">{{statusHint}}</view>
      <view class="row" wx:if="{{pub && pub.status !== 'waiting' && pub.currentPhase !== 'end' && pub.status !== 'ended'}}" style="margin-top: 12rpx">
        <view class="pill">阶段：{{pzh || pub.currentPhase || '—'}}</view>
        <view class="pill" wx:if="{{pub.day}}">第 {{pub.day}} 天</view>
      </view>
    </view>

    <view class="panel" wx:if="{{pub}}">
      <view class="rg-members-card" style="margin-top:0;background:transparent;border:none;padding:0">
        <view class="rg-members-head">
          <text class="rg-members-title">成员</text>
          <text class="rg-members-count">{{memberCountLine}}</text>
        </view>
        <view class="rg-progress-wrap" wx:if="{{pub.maxPlayers}}">
          <view class="rg-progress-bar">
            <view class="rg-progress-fill" style="width: {{playerProgressPct}}%;"></view>
          </view>
        </view>
        <view class="rg-member-list">
          <view class="rg-member-item" wx:for="{{displayPlayers}}" wx:for-item="p" wx:key="openId">
            <view class="rg-avatar">{{p.avatarText}}</view>
            <view class="rg-member-body">
              <view class="rg-member-name-row">
                <text class="rg-member-name">{{p.nickName}}</text>
                <text class="rg-host-badge" wx:if="{{p.isHost}}">👑</text>
                <view class="rg-ready-dot {{p.ready ? 'on' : ''}}"></view>
              </view>
              <text class="rg-ready-label">{{p.readyLabel}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="panel" wx:if="{{pub && pub.status === 'ended' || pub && pub.currentPhase === 'end'}}">
      <view class="end-banner">本环节结束</view>
      <view class="muted" style="margin-top: 12rpx; text-align: center">{{pub && pub.winSide === 'good' ? '村民侧' : pub && pub.winSide === 'wolf' ? '暗位侧' : '—'}} 本环节收束 · {{pub && pub.gameEnd}}</view>
      <button class="btn btn-secondary main-btn btn-ai {{aiUnlock.canRecap ? '' : 'ai-locked'}}" bindtap="doAiRecap" disabled="{{aiBusy}}">AI 战报文案{{aiUnlock.canRecap ? '' : ' 🔒'}}</button>
      <button class="btn btn-secondary main-btn btn-ai {{aiUnlock.canRecap ? '' : 'ai-locked'}}" bindtap="doAiPoster" disabled="{{aiBusy}}">生成海报{{aiUnlock.canRecap ? '' : ' 🔒'}}</button>
    </view>

    <view class="panel" wx:if="{{pub && pub.status === 'waiting' && view && view.isHost}}">
      <view class="rg-section" style="margin-top:0">
        <view class="rg-section-label">目标人数</view>
        <view class="rg-stepper">
          <button class="rg-step-btn" size="mini" data-delta="-1" bindtap="onSizeStep" disabled="{{maxIndex <= 0}}">−</button>
          <picker mode="selector" range="{{maxList}}" value="{{maxIndex}}" bindchange="onMaxChange">
            <view class="rg-step-value">{{maxList[maxIndex]}} 人</view>
          </picker>
          <button class="rg-step-btn" size="mini" data-delta="1" bindtap="onSizeStep" disabled="{{maxIndex >= maxList.length - 1}}">+</button>
        </view>
        <view class="rg-tip">调整人数后自动保存</view>
      </view>
      <button class="rg-btn-primary" bindtap="doStart" disabled="{{opBusy}}">开始互动</button>
    </view>

    <view class="panel" wx:if="{{pub && pub.status === 'playing'}}">
      <view class="priv" wx:if="{{pub.currentPhase !== 'end'}}">
        <view>你本机：{{rzh || '发牌中'}}</view>
        <view wx:if="{{view && view.myRole === 'werewolf' && wolfMatesLine}}" style="margin-top: 8rpx">同组暗位：{{wolfMatesLine}}</view>
        <view wx:if="{{seerLine}}" style="margin-top: 8rpx">本夜线索：{{seerLine}}</view>
      </view>
      <view style="margin-top: 8rpx" wx:if="{{view && view.isHost && allRolesList && allRolesList.length}}">
        <view class="muted" style="font-size: 24rpx">看牌（勿外泄）：</view>
        <view class="muted" style="font-size: 24rpx" wx:for="{{allRolesList}}" wx:for-item="hr" wx:key="o">{{hr.n}}：{{hr.r}}</view>
      </view>
      <view class="log-box" wx:if="{{publicLogText}}">{{publicLogText}}</view>
      <view class="log-box" style="max-height: 180rpx" wx:if="{{lastNightText}}">昨夜：{{lastNightText}}</view>
    </view>

    <view class="panel" wx:if="{{pub && pub.currentPhase === 'night' && pub.status === 'playing' && view && view.myRole === 'werewolf' && view.iAmAlive}}">
      <view class="title">夜间·暗位</view>
      <button class="btn btn-primary rg-btn-ghost" bindtap="wWolfTap">选择夜间关注对象</button>
    </view>
    <view class="panel" wx:if="{{pub && pub.currentPhase === 'night' && view && view.myRole === 'seer' && view.iAmAlive}}">
      <view class="title">夜间·线索员</view>
      <button class="btn btn-ghost rg-btn-ghost" bindtap="wSeerTap">查看一人线索</button>
    </view>
    <view class="panel" wx:if="{{pub && pub.currentPhase === 'night' && view && view.myRole === 'witch' && view.iAmAlive}}">
      <view class="title">夜间·治愈者</view>
      <view class="muted" wx:if="{{view && view.night && view.night.wkill}}">夜间关注对象已同步</view>
      <button class="btn btn-ghost rg-btn-ghost" style="margin-top: 12rpx" bindtap="wWitchSave" wx:if="{{view && view.night && view.night.wwitch && view.night.wwitch.saveLeft}}">为关注对象缓解</button>
      <button class="btn btn-ghost rg-btn-ghost" style="margin-top: 12rpx" bindtap="wWitchPoison" wx:if="{{view && view.night && view.night.wwitch && view.night.wwitch.poisonLeft}}">使用备用提醒（一位暂离）</button>
    </view>
    <view class="panel" wx:if="{{pub && pub.currentPhase === 'vote' && pub.voteOpen && view && view.iAmAlive}}">
      <view class="title">投票</view>
      <button class="btn btn-primary rg-btn-ghost" bindtap="doVote">投票离场</button>
    </view>
    <view class="panel" wx:if="{{pub && pub.currentPhase === 'hunter' && pub.pendingHunter && view && view.myOpenId === pub.pendingHunter && view.myRole === 'hunter'}}">
      <view class="title">协定者</view>
      <button class="btn btn-primary rg-btn-ghost" bindtap="hunterTap">邀请一人同步暂离</button>
    </view>
    <view class="panel" wx:if="{{view && view.isHost && pub && pub.status === 'playing' && pub.currentPhase !== 'hunter' && pub.currentPhase !== 'end'}}">
      <view class="title">主持</view>
      <view class="host-btns" wx:if="{{pub.currentPhase === 'night'}}">
        <button class="btn btn-small btn-primary" bindtap="hostResolveNight">结夜 / 天亮了</button>
      </view>
      <view class="host-btns" wx:if="{{pub.currentPhase === 'day_announce'}}">
        <button class="btn btn-small btn-ghost" bindtap="hostDawn">进发言</button>
      </view>
      <view class="host-btns" wx:if="{{pub.currentPhase === 'speak'}}">
        <button class="btn btn-small btn-ghost" bindtap="hostNext">下一位发言</button>
        <button class="btn btn-small btn-primary" style="margin-left: 8rpx" bindtap="hostVote">开投票</button>
      </view>
      <view class="host-btns" wx:if="{{pub.currentPhase === 'vote'}}">
        <button class="btn btn-small btn-primary" bindtap="hostResolveVote">计票</button>
      </view>
    </view>
  </block>
</view>

<ai-share-modal
  visible="{{showAiShareModal}}"
  next-hint="{{aiUnlock.nextHint || ''}}"
  share-copy="{{shareCopy}}"
  bind:close="onCloseAiShareModal"
  bind:timeline="onAiShareTimeline"
/>
