.page {
  padding: 24rpx 24rpx 100rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: #fef8f0;
}
.panel {
  margin-top: 20rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}
.title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}
.muted {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}
.input {
  flex: 1;
  min-width: 200rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #fafafa;
}
.btn {
  margin: 0;
  padding: 0 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
}
.btn-primary {
  background: #ea580c;
  color: #fff;
  border: none;
}
.btn-ghost {
  background: #fff1e5;
  color: #9a3412;
  border: 1rpx solid #fed7aa;
}
.btn-small {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  margin: 0;
}
.pill {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #fff1e5;
  color: #7c2d12;
  font-size: 24rpx;
  margin: 0 8rpx 8rpx 0;
}
.log-box {
  max-height: 320rpx;
  margin-top: 12rpx;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #374151;
}
.priv {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #0f172a;
  color: #e2e8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.host-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.p-list {
  margin-top: 12rpx;
}
.p-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 28rpx;
}
.away {
  color: #9ca3af;
  text-decoration: line-through;
}
.end-banner {
  margin-top: 16rpx;
  padding: 24rpx;
  text-align: center;
  color: #991b1b;
  background: #fef2f2;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 800;
}
