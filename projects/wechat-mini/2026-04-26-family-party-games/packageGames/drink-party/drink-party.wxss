@import '../../styles/room-game.wxss';

.dp-page-inroom {
  padding-bottom: calc(var(--page-pad-bottom) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--page-pad-bottom) + env(safe-area-inset-bottom));
}

.dp-hero-compact {
  margin-bottom: var(--space-md);
}

.dp-hero-compact .hero-title {
  font-size: var(--font-title-size);
  line-height: var(--font-title-lh);
}

.dp-card {
  margin-bottom: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.dp-label {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-accent);
  margin-bottom: var(--space-xs);
}

.dp-inp {
  width: 100%;
  min-height: var(--btn-secondary-height);
  padding: 0 var(--space-md);
  margin: var(--space-sm) 0 0;
  border-radius: var(--radius-md);
  background: var(--color-bg-muted);
  box-sizing: border-box;
  font-size: var(--font-body-size);
  color: var(--color-text);
}

.dp-host-name {
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--color-border);
}

.dp-ghost {
  text-align: center;
  color: var(--color-text-accent);
  font-size: var(--font-body-size);
  font-weight: var(--font-weight-medium);
  margin-top: var(--space-sm);
  padding: var(--space-xs);
}

.dp-members-inner {
  margin-top: var(--space-md);
  padding: 0;
  background: transparent;
  border: none;
}

.dp-vote-progress-text {
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  text-align: center;
}

.dp-member-votable:active {
  opacity: 0.85;
  transform: scale(0.99);
}

.dp-member-picked {
  border-color: var(--color-brand) !important;
  background: #fff7ed !important;
  box-shadow: 0 0 0 2rpx rgba(255, 122, 47, 0.25);
}

.dp-vote-check {
  font-size: var(--font-caption-size);
  color: var(--color-success);
  font-weight: var(--font-weight-semibold);
}

.dp-main-btn {
  margin-top: var(--space-lg);
  margin-bottom: var(--space-xl);
}

/* ---------- 阶段卡片（倒计时/投票/结果置顶） ---------- */
.dp-phase-prominent {
  border: 2rpx solid rgba(255, 122, 47, 0.35);
  box-shadow: 0 8rpx 32rpx rgba(255, 122, 47, 0.12);
}

.dp-phase-card {
  text-align: center;
}

.dp-countdown-num {
  font-size: 120rpx;
  line-height: 1.1;
  font-weight: var(--font-weight-semibold);
  color: var(--color-brand);
  margin: var(--space-xl) 0 var(--space-sm);
  text-shadow: 0 8rpx 28rpx rgba(255, 122, 47, 0.2);
}

.dp-countdown-sub {
  color: var(--color-text-secondary);
  margin-bottom: var(--space-sm);
}

.dp-countdown-tip {
  color: var(--color-text-secondary);
  padding-bottom: var(--space-md);
}

/* 倒计时成员背景：简单变暗，无闪烁 */
.dp-member-pulse {
  opacity: 0.75;
  background: rgba(0, 0, 0, 0.02) !important;
  transition: opacity 0.3s ease;
}

@keyframes dp-member-urgency {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.75;
  }
}

/* ---------- 投票 ---------- */
.dp-phase-title {
  text-align: left;
  margin-bottom: var(--space-sm);
}

.dp-sub-tip {
  text-align: left;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-secondary-bg);
  color: var(--color-text-secondary);
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  margin-bottom: var(--space-md);
}

.dp-ringer-hint {
  text-align: center;
  color: var(--color-brand);
  font-size: var(--font-card-title-size);
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--space-sm);
}

.dp-vote-timer {
  text-align: center;
  margin-bottom: var(--space-md);
  color: var(--color-text);
}

.dp-em {
  color: var(--color-brand-deep);
  font-weight: var(--font-weight-medium);
}

.dp-vote-done-tip {
  text-align: center;
  margin: var(--space-md) 0;
}

.dp-vote-actions {
  margin-top: var(--space-sm);
}

.dp-force-btn {
  margin-top: var(--space-md);
}

/* ---------- 结果 + AI ---------- */
.dp-drink-hero {
  font-size: 44rpx;
  line-height: 1.35;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-accent);
  text-align: center;
  padding: var(--space-sm) 0;
}

.dp-result-sub {
  margin-top: var(--space-sm);
  text-align: center;
}

.dp-result-line {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
  text-align: left;
}

.dp-bignum {
  color: var(--color-brand);
  font-size: var(--font-title-size);
  font-weight: var(--font-weight-semibold);
  margin: 0 4rpx;
}

.dp-result-wrong {
  margin-top: var(--space-md);
  color: var(--color-text-secondary);
  text-align: left;
}

.dp-ai-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.dp-ai-row .btn-ai {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 80rpx;
  padding: 0 var(--space-md);
  box-sizing: border-box;
  background: linear-gradient(135deg, #a855f7, #7c3aed) !important;
  color: var(--color-text-inverse) !important;
  border-radius: var(--radius-lg);
  font-size: var(--font-body-size);
  font-weight: var(--font-weight-medium);
  border: none;
  line-height: var(--font-body-lh);
}

.dp-ai-row .btn-ai::after {
  border: none;
}

.dp-ai-row .btn-ai.ai-locked {
  opacity: 0.6;
}

.ring-flash {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 0, 0, 0.3);
  pointer-events: none;
  z-index: 999;
  animation: dp-ring-blink 0.2s 3;
}

@keyframes dp-ring-blink {
  0% {
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

.dp-vote-stats {
  margin-top: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-muted);
}

.dp-vote-stats-title {
  font-size: var(--font-caption-size);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-xs);
}

.dp-vote-stat-item {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  color: var(--color-text);
  padding: var(--space-xs) 0;
}

.dp-reroll-btn {
  margin-top: var(--space-md);
}

/* ---------- 转盘抽奖 ---------- */
.dp-roulette-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dp-roulette-modal {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  width: 80%;
  max-width: 500rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}

.dp-roulette-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: var(--color-text-accent);
}

.dp-roulette-wheel {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #ffd89b, #ffed4e);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid #ffa500;
  cursor: pointer;
  box-shadow: 0 8rpx 24rpx rgba(255, 165, 0, 0.3);
}

.dp-roulette-wheel::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: conic-gradient(
    #ff6b6b 0deg 72deg,
    #4ecdc4 72deg 144deg,
    #45b7d1 144deg 216deg,
    #f9ca24 216deg 288deg,
    #6c5ce7 288deg 360deg
  );
  opacity: 0.1;
}

.dp-roulette-item {
  position: absolute;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  padding: 16rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
  opacity: 0.5;
  transform: scale(0.8);
}

.dp-roulette-item.active {
  opacity: 1;
  transform: scale(1.1);
  color: var(--color-brand);
  text-shadow: 0 2rpx 8rpx rgba(255, 122, 47, 0.3);
  animation: dp-pulse-item 0.3s ease;
}

@keyframes dp-pulse-item {
  0% {
    transform: scale(0.9);
  }
  50% {
    transform: scale(1.15);
  }
  100% {
    transform: scale(1.1);
  }
}

.dp-roulette-indicator {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 20rpx solid #ff6b6b;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2));
}

.dp-roulette-hint {
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  margin-bottom: 24rpx;
  min-height: 40rpx;
}

.dp-roulette-actions {
  display: flex;
  gap: 16rpx;
}

.dp-roulette-actions .btn {
  flex: 1;
  min-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
