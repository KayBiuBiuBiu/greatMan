@import '../../styles/room-game.wxss';

.dp-page-inroom {
  padding-bottom: calc(var(--page-pad-bottom) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--page-pad-bottom) + env(safe-area-inset-bottom));
}

.dp-hero-compact {
  margin-bottom: var(--space-md);
}

.dp-hero-compact .hero-title {
  font-size: var(--font-title-size);
  line-height: var(--font-title-lh);
}

.dp-card {
  margin-bottom: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.dp-label {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-accent);
  margin-bottom: var(--space-xs);
}

.dp-inp {
  width: 100%;
  min-height: var(--btn-secondary-height);
  padding: 0 var(--space-md);
  margin: var(--space-sm) 0 0;
  border-radius: var(--radius-md);
  background: var(--color-bg-muted);
  box-sizing: border-box;
  font-size: var(--font-body-size);
  color: var(--color-text);
}

.dp-host-name {
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--color-border);
}

.dp-ghost {
  text-align: center;
  color: var(--color-text-accent);
  font-size: var(--font-body-size);
  font-weight: var(--font-weight-medium);
  margin-top: var(--space-sm);
  padding: var(--space-xs);
}

.dp-members-inner {
  margin-top: var(--space-md);
  padding: 0;
  background: transparent;
  border: none;
}

.dp-vote-progress-text {
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  text-align: center;
}

.dp-member-votable:active {
  opacity: 0.85;
  transform: scale(0.99);
}

.dp-member-picked {
  border-color: var(--color-brand) !important;
  background: #fff7ed !important;
  box-shadow: 0 0 0 2rpx rgba(255, 122, 47, 0.25);
}

.dp-vote-check {
  font-size: var(--font-caption-size);
  color: var(--color-success);
  font-weight: var(--font-weight-semibold);
}

.dp-main-btn {
  margin-top: var(--space-lg);
  margin-bottom: var(--space-xl);
}

/* ---------- 阶段卡片（倒计时/投票/结果置顶） ---------- */
.dp-phase-prominent {
  border: 2rpx solid rgba(255, 122, 47, 0.35);
  box-shadow: 0 8rpx 32rpx rgba(255, 122, 47, 0.12);
}

.dp-phase-card {
  text-align: center;
}

.dp-countdown-num {
  font-size: 120rpx;
  line-height: 1.1;
  font-weight: var(--font-weight-semibold);
  color: var(--color-brand);
  margin: var(--space-xl) 0 var(--space-sm);
  text-shadow: 0 8rpx 28rpx rgba(255, 122, 47, 0.2);
}

.dp-countdown-sub {
  color: var(--color-text-secondary);
  margin-bottom: var(--space-sm);
}

.dp-countdown-tip {
  color: var(--color-text-secondary);
  padding-bottom: var(--space-md);
}

/* 倒计时成员背景：简单变暗，无闪烁 */
.dp-member-pulse {
  opacity: 0.75;
  background: rgba(0, 0, 0, 0.02) !important;
  transition: opacity 0.3s ease;
}

@keyframes dp-member-urgency {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.75;
  }
}

/* ---------- 投票 ---------- */
.dp-phase-title {
  text-align: left;
  margin-bottom: var(--space-sm);
}

.dp-sub-tip {
  text-align: left;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-secondary-bg);
  color: var(--color-text-secondary);
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  margin-bottom: var(--space-md);
}

.dp-ringer-hint {
  text-align: center;
  color: var(--color-brand);
  font-size: var(--font-card-title-size);
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--space-sm);
}

.dp-vote-timer {
  text-align: center;
  margin-bottom: var(--space-md);
  color: var(--color-text);
}

.dp-em {
  color: var(--color-brand-deep);
  font-weight: var(--font-weight-medium);
}

.dp-vote-done-tip {
  text-align: center;
  margin: var(--space-md) 0;
}

.dp-vote-actions {
  margin-top: var(--space-sm);
}

.dp-force-btn {
  margin-top: var(--space-md);
}

/* ---------- 结果 + AI ---------- */
.dp-drink-hero {
  font-size: 44rpx;
  line-height: 1.35;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-accent);
  text-align: center;
  padding: var(--space-sm) 0;
}

.dp-result-sub {
  margin-top: var(--space-sm);
  text-align: center;
}

.dp-result-line {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
  text-align: left;
}

.dp-bignum {
  color: var(--color-brand);
  font-size: var(--font-title-size);
  font-weight: var(--font-weight-semibold);
  margin: 0 4rpx;
}

.dp-result-wrong {
  margin-top: var(--space-md);
  color: var(--color-text-secondary);
  text-align: left;
}

.dp-ai-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.dp-ai-row .btn-ai {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 80rpx;
  padding: 0 var(--space-md);
  box-sizing: border-box;
  background: linear-gradient(135deg, #a855f7, #7c3aed) !important;
  color: var(--color-text-inverse) !important;
  border-radius: var(--radius-lg);
  font-size: var(--font-body-size);
  font-weight: var(--font-weight-medium);
  border: none;
  line-height: var(--font-body-lh);
}

.dp-ai-row .btn-ai::after {
  border: none;
}

.dp-ai-row .btn-ai.ai-locked {
  opacity: 0.6;
}

.ring-flash {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 0, 0, 0.3);
  pointer-events: none;
  z-index: 999;
  animation: dp-ring-blink 0.2s 3;
}

@keyframes dp-ring-blink {
  0% {
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

.dp-vote-stats {
  margin-top: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-muted);
}

.dp-vote-stats-title {
  font-size: var(--font-caption-size);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-xs);
}

.dp-vote-stat-item {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  color: var(--color-text);
  padding: var(--space-xs) 0;
}

.dp-reroll-btn {
  margin-top: var(--space-md);
}

/* 成员列表中的抽奖结果徽章 */
.dp-lottery-badge {
  margin-left: 8rpx;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, var(--color-brand), #ff8c1a);
  color: white;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 20rpx;
  display: inline-block;
}

/* ---------- 第一个弹窗：选择口数方式 ---------- */
.dp-choose-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dp-choose-modal {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  width: 88%;
  max-width: 500rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  text-align: center;
  max-height: 80vh;
  overflow: hidden;
}

.dp-choose-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1.3;
  margin: 0;
}

.dp-choose-subtitle {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  margin: 0;
}

.dp-choose-actions {
  display: flex;
  gap: 12rpx;
  width: 100%;
  margin-top: 0;
}

.dp-choose-btn {
  flex: 1;
  min-height: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  line-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dp-choose-btn.btn-secondary {
  background: #f0f0f0;
  color: #333;
}

.dp-choose-btn.btn-primary {
  background: linear-gradient(135deg, var(--color-brand), #ff8c1a);
  color: white;
}

/* ---------- 单行抽奖滚动 ---------- */
.dp-lottery-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dp-lottery-modal {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  width: 88%;
  max-width: 500rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  max-height: 80vh;
  overflow: hidden;
}

.dp-lottery-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  color: var(--color-brand);
}

.dp-lottery-scroll-line {
  position: relative;
  height: 72rpx;
  background: transparent;
  border: none;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  width: 100%;
  margin: 12rpx 0;
}

.dp-lottery-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand);
  text-align: center;
  white-space: nowrap;
  transition: opacity 0.2s ease;
}

.dp-lottery-text.animating {
  animation: dp-text-pulse 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes dp-text-pulse {
  0% {
    opacity: 0.6;
    transform: scale(0.95);
  }
  50% {
    opacity: 1;
    transform: scale(1.05);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

.dp-lottery-confirm {
  width: 100%;
  min-height: 72rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(135deg, var(--color-brand), #ff8c1a);
  color: white;
  border: none;
}
