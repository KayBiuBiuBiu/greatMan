<view class="page play-page">
  <view class="hero">
    <view class="hero-title">{{title}}</view>
    <view class="hero-subtitle">{{mode === 'truthDareRoom' ? '进聚会组后随机选人，大家投票' : mode === 'riddle' ? '同一道汤面可分享给好友远程同乐' : '随机题与计时辅助'}}</view>
  </view>

  <!-- 同场同步·真心话大冒险 -->
  <view wx:if="{{mode === 'truthDareRoom'}}" class="card td-card">
    <view wx:if="{{tdPhase==='none'}}" class="td-block">
      <view class="td-lead">创建或加入 4 位口令聚会组后，每人用自己手机进组。满 2 人由<text class="td-em">主持</text>开一轮，系统随机 1 位被选中；其余人在各自手机上投真心话或大冒险，全员投完自动计票。</view>
      <view class="rg-code-row" wx:if="{{roomCode}}" style="margin-top: var(--space-md)">
        <view class="rg-code-main">
          <text class="rg-code-label">聚会组口令</text>
          <view class="rg-code-num-row rg-code-tap" bindtap="onCopyRoomCode">
            <text class="rg-code-num">{{roomCode}}</text>
          </view>
        </view>
        <button class="btn-wechat-invite rg-invite-btn" open-type="share">邀请朋友</button>
      </view>
      <view class="rg-status-banner" wx:if="{{statusHint && tdPhase==='none'}}">{{statusHint}}</view>
      <view
        class="rg-members-head"
        wx:if="{{tdPhase==='none' && memberCountLine && (!displayPlayers || !displayPlayers.length)}}"
        style="margin-top:20rpx"
      >
        <text class="rg-members-title">成员</text>
        <text class="muted rg-members-count">{{memberCountLine}}</text>
      </view>
      <view class="rg-members-card" wx:if="{{displayPlayers && displayPlayers.length}}" style="margin-top:20rpx">
        <view class="rg-members-head">
          <text class="rg-members-title">成员</text>
          <text class="muted rg-members-count">{{memberCountLine}}</text>
        </view>
        <view class="rg-member-list">
          <view class="rg-member-item" wx:for="{{displayPlayers}}" wx:for-item="p" wx:key="openId">
            <member-avatar avatar-url="{{p.avatarUrl}}" nick-name="{{p.nickName}}" letter="{{p.avatarText}}" />
            <view class="rg-member-body">
              <view class="rg-member-name-row">
                <text class="rg-member-name">{{p.nickName}}</text>
                <text class="rg-host-badge" wx:if="{{p.isHost}}">👑</text>
                <view class="rg-ready-dot {{p.ready ? 'on' : ''}}"></view>
              </view>
              <text class="rg-ready-label">{{p.readyLabel}}</text>
            </view>
          </view>
        </view>
      </view>
      <room-ready-bar
        wx:if="{{tdPhase==='none' && roomCode && !tdIsHost}}"
        ready="{{lobbySelfReady}}"
        bind:tapready="onLobbyReadyTap"
      />
      <button
        wx:if="{{tdIsHost}}"
        class="btn btn-primary main-btn rg-btn-primary {{canStart ? '' : 'rg-start-muted'}}"
        bindtap="tdStartRound"
      >开始本轮</button>
      <view wx:if="{{tdIsHost && tdRoomPlayers.length > 1}}" class="td-host-tools">
        <button class="btn btn-secondary main-btn" style="margin-top: 16rpx" bindtap="tdShowTransferSheet">指定新任主持…</button>
        <button class="btn btn-secondary main-btn" style="margin-top: 12rpx" bindtap="tdAbdicateHost">移交给最早进组的一位</button>
      </view>
    </view>
    <view wx:if="{{tdPhase==='voting'}}" class="td-block">
      <view class="td-boom">本轮</view>
      <view class="td-name">{{tdTargetName}}</view>
      <view wx:if="{{tdIsTarget}}" class="td-tip warn">你本轮被选中，请让其他人在各自手机上投票，不要自己点。</view>
      <view wx:else>
        <view class="td-tip">请在你自己的手机上为 TA 投一票（可改投，全员投完自动出结果）</view>
        <view class="td-tally">已投 {{tdVoteCast}} / {{tdVoteNeed}} · 真心话 {{tdTruth}} 票 · 大冒险 {{tdDare}} 票</view>
        <view class="td-vote-btns">
          <button class="btn btn-primary td-half" data-choice="truth" bindtap="tdCastVote">真心话</button>
          <button class="btn btn-secondary td-half" data-choice="dare" bindtap="tdCastVote">大冒险</button>
        </view>
        <view wx:if="{{tdMyChoice}}" class="td-tip ok">已投：{{tdMyChoice === 'truth' ? '真心话' : '大冒险'}}</view>
        <view wx:elif="{{!tdIsTarget && !tdMyChoice}}" class="muted">请点一个按钮</view>
        <view wx:if="{{tdVoteNeed > 0 && tdVoteCast >= tdVoteNeed}}" class="td-tip ok">全员已投，正在统计…</view>
      </view>
      <button
        wx:if="{{tdIsHost && tdVoteNeed > tdVoteCast}}"
        class="btn btn-secondary main-btn"
        bindtap="tdFinish"
      >提前结束投票</button>
    </view>
    <view wx:if="{{tdPhase==='resolved' && tdLastTally && tdLastTally.tie}}" class="td-block">
      <view class="td-boom">平票</view>
      <view class="td-egg-label">隐藏彩蛋</view>
      <view class="td-curse egg-body">{{tdLastTally.curseText}}</view>
      <view class="td-tip">得票：真心话 {{tdLastTally.truthCount}} · 大冒险 {{tdLastTally.dareCount}}</view>
      <button wx:if="{{tdIsHost}}" class="btn btn-primary main-btn" bindtap="tdStartRound">进入下一轮</button>
    </view>
    <view wx:elif="{{tdPhase==='resolved' && tdLastTally && !tdLastTally.tie}}" class="td-block">
      <view class="td-boom">本轮结果</view>
      <view class="td-tip">得票 真心话 {{tdLastTally.truthCount}} · 大冒险 {{tdLastTally.dareCount}}，胜出：<text class="td-em">{{tdLastTally.winner === 'truth' ? '真心话' : '大冒险'}}</text></view>
      <view wx:if="{{tdHasQuestion}}" class="td-q-public">
        <view class="td-q-title">{{tdQuestionTitle}}</view>
        <view class="td-q-detail">{{tdQuestionDetail}}</view>
        <view class="muted sm" wx:if="{{!tdIsTarget}}">由 {{tdTargetName}} 抽取，全场同步显示</view>
      </view>
      <block wx:if="{{tdIsTarget}}">
        <view wx:if="{{!tdHasQuestion}}">
          <button class="btn btn-primary main-btn" bindtap="tdDrawQuestion">看随机一题</button>
          <view class="muted sm">抽题后所有人手机上都会显示同一道题</view>
        </view>
        <view wx:else>
          <button wx:if="{{aiButtonsEnabled}}" class="btn btn-secondary main-btn btn-ai" bindtap="onAiSpicePrompt" disabled="{{aiBusy}}">AI 出题</button>
          <button class="btn btn-secondary main-btn" bindtap="tdDrawQuestion">同类型再换一题</button>
        </view>
      </block>
      <view wx:elif="{{!tdHasQuestion}}" class="td-tip">请 <text class="td-em">{{tdTargetName}}</text> 在自己手机上点「看随机一题」</view>
      <button wx:if="{{tdIsHost}}" class="btn btn-primary main-btn" bindtap="tdNextRound">进入下一轮</button>
    </view>
  </view>

  <view wx:if="{{mode === 'truthDare'}}" class="tabs">
    <button class="btn {{questionType === 'truth' ? 'btn-primary' : 'btn-secondary'}} tab" data-type="truth" bindtap="switchQuestionType">真心话</button>
    <button class="btn {{questionType === 'dare' ? 'btn-primary' : 'btn-secondary'}} tab" data-type="dare" bindtap="switchQuestionType">大冒险</button>
  </view>
  <button wx:if="{{aiButtonsEnabled && mode === 'truthDare'}}" class="btn btn-secondary main-btn btn-ai" bindtap="onAiGenTruthDare" disabled="{{aiBusy}}">AI 出新题</button>

  <view wx:if="{{mode === 'number'}}" class="card prompt-card">
    <view class="prompt-title">范围 {{numberLow}} - {{numberHigh}}</view>
    <view class="prompt-detail">{{numberMessage}}</view>
    <view class="muted">已猜 {{count}} 次</view>
    <button class="btn btn-primary main-btn" bindtap="askNumber">输入猜测</button>
    <button class="btn btn-secondary main-btn" bindtap="resetNumber">开始新局</button>
  </view>

  <view wx:if="{{mode === 'riddle'}}" class="card rg-invite-card">
    <button class="btn-wechat-invite rg-invite-btn" open-type="share" bindtap="onRiddleShareTap">邀请朋友</button>
    <view class="muted sm" style="margin-top: 12rpx; text-align: center">好友点开卡片将看到同一道汤面（汤面、汤底、提示）</view>
  </view>

  <view wx:if="{{mode !== 'truthDareRoom' && mode !== 'number'}}" class="card prompt-card">
    <view class="prompt-title">{{prompt.title}}</view>
    <view class="prompt-detail">{{prompt.detail}}</view>
    <view wx:if="{{prompt.hint}}" class="hint">提示：{{prompt.hint}}</view>
    <view wx:if="{{showAnswer && prompt.answer}}" class="answer">答案：{{prompt.answer}}</view>
    <button class="btn btn-primary main-btn" bindtap="nextPrompt">换一个</button>
    <button wx:if="{{aiButtonsEnabled && (mode === 'truthDare' || (mode === 'truthDareRoom' && tdShowQuestion && prompt.detail))}}" class="btn btn-secondary main-btn btn-ai" bindtap="onAiSpicePrompt" disabled="{{aiBusy}}">AI 出题</button>
    <button wx:if="{{aiButtonsEnabled && mode === 'story'}}" class="btn btn-secondary main-btn btn-ai" bindtap="onAiStoryLine" disabled="{{aiBusy}}">AI 接一句</button>
    <button wx:if="{{prompt.answer}}" class="btn btn-secondary main-btn" bindtap="toggleAnswer">{{showAnswer ? '隐藏答案' : '看答案'}}</button>
  </view>

  <view wx:if="{{(mode === 'garden' || mode === 'traffic' || mode === 'reverse' || mode === 'timerRandom') && mode !== 'truthDareRoom'}}" class="card timer-card">
    <view class="timer-number">{{seconds}} 秒</view>
    <button class="btn btn-primary main-btn" bindtap="toggleTimer">{{timerRunning ? '暂停' : '开始计时'}}</button>
    <button class="btn btn-secondary main-btn" bindtap="resetTimer">重置计时</button>
  </view>

  <view wx:if="{{mode === 'story' && mode !== 'truthDareRoom'}}" class="card score-card">
    <view class="section-title compact">故事记录</view>
    <view class="score-text">已接 {{storyLines.length}} 句</view>
    <button class="btn btn-primary main-btn" bindtap="addStoryLine">记录一句</button>
  </view>
</view>

<user-info-modal
  wx:if="{{showUserInfoModal}}"
  visible="{{showUserInfoModal}}"
  bind:success="onLobbyUserInfoSuccess"
  bind:cancel="onLobbyUserInfoCancel"
/>

<ai-share-modal
  visible="{{showAiShareModal}}"
  share-token-ready="{{shareTokenReady}}"
  next-hint="{{aiUnlock.nextHint || ''}}"
  share-copy="{{shareCopy}}"
  bind:close="onCloseAiShareModal"
  bind:timeline="onAiShareTimeline"
/>
