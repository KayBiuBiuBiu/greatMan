@import '../../styles/room-game.wxss';

.ww-page-inroom {
  padding-bottom: calc(var(--page-pad-bottom) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--page-pad-bottom) + env(safe-area-inset-bottom));
}

.ww-end-banner {
  text-align: center;
  color: var(--color-brand);
}

.ww-ai-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.ww-ai-row .btn-ai {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 80rpx;
  padding: 0 var(--space-md);
  box-sizing: border-box;
  background: linear-gradient(135deg, #a855f7, #7c3aed) !important;
  color: var(--color-text-inverse) !important;
  border-radius: var(--radius-lg);
  font-size: var(--font-body-size);
  font-weight: var(--font-weight-medium);
  border: none;
  line-height: var(--font-body-lh);
}

.ww-ai-row .btn-ai::after {
  border: none;
}

.ww-ai-row .btn-ai.ai-locked {
  opacity: 0.6;
}

.ww-phase-card .title {
  font-size: var(--font-card-title-size);
  line-height: var(--font-card-title-lh);
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--space-sm);
}

.ww-phase-card .priv {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  color: var(--color-text);
}

.ww-phase-card .muted {
  font-size: var(--font-caption-size);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
}

.log-box {
  margin-top: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  font-size: var(--font-caption-size);
  line-height: 1.5;
  color: var(--color-text-secondary);
  word-break: break-all;
}

.host-btns {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.ww-phase-card .btn,
.ww-phase-card button.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  box-sizing: border-box;
}

.ww-phase-card .btn-small {
  min-height: 64rpx;
  padding: 0 var(--space-md);
  font-size: var(--font-caption-size);
}

.rg-mock-tools {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}

.rg-mock-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.rg-mock-btn {
  flex: 1;
  margin: 0 !important;
  font-size: 26rpx;
}

.rg-pick-banner {
  margin: 12rpx 0;
  padding: 16rpx 20rpx;
  background: #fff7ed;
  border: 2rpx solid #fdba74;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #c2410c;
  line-height: 1.4;
}

.rg-member-pickable {
  border-color: #fdba74 !important;
  background: #fffbeb !important;
}

.rg-member-picked {
  border-color: #f97316 !important;
  background: #ffedd5 !important;
  box-shadow: 0 0 0 2rpx rgba(249, 115, 22, 0.25);
}

.rg-pick-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.rg-pick-confirm,
.rg-pick-cancel-btn {
  flex: 1;
  margin: 0 !important;
}

.ww-pick-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.ww-pick-cancel {
  margin-top: 8rpx;
}

.ww-agent-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.ww-agent-line {
  font-size: var(--font-caption-size);
  line-height: 1.5;
  margin-bottom: var(--space-sm);
  word-break: break-all;
}
