}

.ww-phase-card .btn-small {
  min-height: 64rpx;
  padding: 0 var(--space-md);
  font-size: var(--font-caption-size);
}

.rg-mock-tools {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}

.rg-mock-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.rg-mock-btn {
  flex: 1;
  margin: 0 !important;
  font-size: 26rpx;
}

.rg-pick-banner {
  margin: 12rpx 0;
  padding: 16rpx 20rpx;
  background: #fff7ed;
  border: 2rpx solid #fdba74;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #c2410c;
  line-height: 1.4;
}

.rg-member-pickable {
  border-color: #fdba74 !important;
  background: #fffbeb !important;
}

.rg-member-picked {
  border-color: #f97316 !important;
  background: #ffedd5 !important;
  box-shadow: 0 0 0 2rpx rgba(249, 115, 22, 0.25);
}

.rg-pick-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.rg-pick-confirm,
.rg-pick-cancel-btn {
  flex: 1;
  margin: 0 !important;
}

.ww-pick-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.ww-pick-cancel {
  margin-top: 8rpx;
}

.ww-agent-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.ww-agent-line {
  font-size: var(--font-caption-size);
  line-height: 1.5;
  margin-bottom: var(--space-sm);
  word-break: break-all;
}
