<!-- 未进房 -->
<view class="page ddi-page" wx:if="{{!roomId}}">
  <view class="hero">
    <view class="hero-title">不要做挑战</view>
    <view class="hero-subtitle">每人看自己禁止动作为「保密」，看别人真实动作；诱导他人犯规，坚持到最后获胜。6 位口令，至少 2 人。</view>
  </view>
  <view class="ddi-card">
    <view class="ddi-label">昵称</view>
    <input class="ddi-inp" placeholder="输入昵称" value="{{nick}}" bindinput="onNick" />
    <button class="btn btn-primary main-btn" bindtap="doCreate" disabled="{{opBusy}}">创建聚会组</button>
  </view>
  <view class="ddi-card">
    <view class="ddi-label">已有口令</view>
    <input class="ddi-inp" type="number" maxlength="6" placeholder="6 位数字" value="{{joinCode}}" bindinput="onCode" />
    <button class="btn btn-secondary main-btn" bindtap="doJoin" disabled="{{opBusy}}">加入聚会组</button>
  </view>
</view>

<!-- 已进房 -->
<view class="page ddi-page ddi-page-inroom" wx:else>
  <view class="hero ddi-hero-compact">
    <view class="hero-title">不要做挑战</view>
    <view class="hero-subtitle text-caption" wx:if="{{view.roomCode}}">口令 {{view.roomCode}} · 存活 {{aliveCount}} 人</view>
  </view>

  <view class="ddi-card" wx:if="{{view.roomCode}}">
    <view class="rg-code-row">
      <view class="rg-code-main">
        <text class="rg-code-label">聚会组口令</text>
        <view class="rg-code-num-row rg-code-tap" bindtap="onCopyRoomCode">
          <text class="rg-code-num">{{view.roomCode}}</text>
        </view>
      </view>
      <button class="btn-wechat-invite rg-invite-btn" open-type="share">邀请朋友</button>
    </view>
  </view>

  <view class="ddi-card ddi-phase-card" wx:if="{{inFinished}}">
    <view class="ddi-win-hero" wx:if="{{view.survivorNames}}">🏆 幸存者：{{view.survivorNames}}</view>
    <view class="ddi-win-hero" wx:else>本局已结束</view>
    <view class="ddi-win-sub" wx:if="{{view.eliminatedCount > 0}}">共 {{view.eliminatedCount}} 人已淘汰</view>
  </view>

  <view class="ddi-card" wx:if="{{view}}">
    <view class="rg-status-banner {{statusBannerWarn ? 'rg-banner-warn' : ''}}" wx:if="{{statusHint}}">{{statusHint}}</view>

    <view class="rg-members-card ddi-members-inner">
      <view class="rg-members-head">
        <text class="rg-members-title">成员</text>
        <text class="rg-members-count muted">{{memberCountLine}}</text>
      </view>
      <view class="rg-progress-wrap" wx:if="{{inWaiting}}">
        <view class="rg-progress-bar">
          <view class="rg-progress-fill" style="width: {{playerProgressPct}}%;"></view>
        </view>
      </view>
      <view class="rg-member-list">
        <view
          class="rg-member-item {{p.isEliminated ? 'ddi-member-out' : ''}}"
          wx:for="{{displayPlayers}}"
          wx:for-item="p"
          wx:key="openId"
        >
          <member-avatar avatar-url="{{p.avatarUrl}}" nick-name="{{p.nickName}}" letter="{{p.avatarText}}" />
          <view class="rg-member-body">
            <view class="rg-member-name-row">
              <text class="rg-member-name">{{p.nickName}}</text>
              <text class="rg-host-badge" wx:if="{{p.isHost}}">👑</text>
              <button
                wx:if="{{isHost && inPlaying && !p.isEliminated && p.openId !== view.myOpenId}}"
                class="btn btn-secondary ddi-elim-btn"
                size="mini"
                data-oid="{{p.openId}}"
                data-nick="{{p.nickName}}"
                bindtap="onEliminatePlayer"
                disabled="{{opBusy}}"
              >淘汰</button>
            </view>
            <text class="rg-ready-label" wx:if="{{p.subLabel}}">{{p.subLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <room-ready-bar
    wx:if="{{inWaiting && !isHost}}"
    ready="{{lobbySelfReady}}"
    bind:tapready="onLobbyReadyTap"
  />

  <view class="ddi-card" wx:if="{{isHost && (inWaiting || inFinished)}}">
    <view class="section-title compact">游戏设置</view>
    <picker mode="selector" range="{{difficultyLabels}}" value="{{difficultyIdx}}" bindchange="onDifficultyPick">
      <view class="ddi-picker-line">
        <text>难度</text>
        <text class="muted">{{difficultyLabels[difficultyIdx]}}</text>
      </view>
    </picker>
    <view class="text-caption" style="margin-top: 12rpx">开局时按人数每人分配 1 个禁止动作（互不重复）</view>
  </view>

  <button
    class="rg-btn-primary main-btn ddi-main-btn {{canStart ? '' : 'rg-start-muted'}}"
    wx:if="{{isHost && inWaiting}}"
    bindtap="onStartGame"
    disabled="{{opBusy || !canStart}}"
  >开始挑战</button>

  <button
    wx:if="{{isHost && inPlaying}}"
    class="btn btn-secondary main-btn ddi-main-btn"
    bindtap="onEndGame"
    disabled="{{opBusy}}"
  >结束游戏</button>

  <button
    class="rg-btn-primary main-btn ddi-main-btn {{canRestart ? '' : 'rg-start-muted'}}"
    wx:if="{{isHost && inFinished}}"
    bindtap="onPlayAgain"
    disabled="{{opBusy || !canRestart}}"
  >再来一盘</button>
  <view class="ddi-action-tip text-caption" wx:if="{{inFinished && !isHost}}">等待组长再来一盘</view>

  <view class="ddi-action-bar" wx:if="{{inPlaying && !iAmEliminated}}">
    <view class="ddi-action-tip">不小心做了自己的禁止动作？点下面按钮自认淘汰</view>
    <button class="btn btn-primary ddi-trigger-btn" bindtap="onSelfTrigger" disabled="{{opBusy}}">我犯规了？</button>
  </view>
  <view class="ddi-action-bar" wx:elif="{{inPlaying && iAmEliminated}}">
    <view class="ddi-action-tip">你已被淘汰，可观战继续</view>
  </view>
</view>

<user-info-modal
  wx:if="{{showUserInfoModal}}"
  visible="{{showUserInfoModal}}"
  bind:success="onLobbyUserInfoSuccess"
  bind:cancel="onLobbyUserInfoCancel"
/>

<ai-share-modal
  visible="{{showAiShareModal}}"
  share-token-ready="{{shareTokenReady}}"
  next-hint="{{aiUnlock.nextHint || ''}}"
  share-copy="{{shareCopy}}"
  bind:close="onCloseAiShareModal"
  bind:timeline="onAiShareTimeline"
/>
