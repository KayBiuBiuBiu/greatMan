@import '../../styles/room-game.wxss';

.sg-page-inroom {
  padding-bottom: calc(var(--page-pad-bottom) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--page-pad-bottom) + env(safe-area-inset-bottom));
}

.sg-play-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.sg-host-line {
  margin: var(--space-sm) 0;
}

.sg-em {
  color: var(--color-brand-deep);
  font-weight: var(--font-weight-medium);
}

.sg-song-title {
  font-size: var(--font-title-size);
  line-height: var(--font-title-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-brand);
  margin: var(--space-sm) 0;
  text-align: center;
}

.sg-hits {
  margin-top: var(--space-md);
}

.sg-ans-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.sg-ans-inp {
  flex: 1;
  margin: 0;
}

.sg-ans-row .btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  height: var(--btn-secondary-height);
  min-height: var(--btn-secondary-height);
  padding: 0 var(--space-md);
  line-height: 1;
  margin: 0;
}

.sg-ans-row .btn::after {
  border: none;
}

.sg-rank {
  padding: var(--space-xs) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.sg-rank:last-child {
  border-bottom: none;
}

.sg-log-line {
  padding: 2rpx 0;
  word-break: break-all;
}

.sg-host-card {
  text-align: center;
}
