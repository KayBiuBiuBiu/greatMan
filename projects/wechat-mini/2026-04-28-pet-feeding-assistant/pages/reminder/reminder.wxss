.page.rem {
  padding: 20rpx 24rpx 120rpx;
}
.rem-i {
  margin-bottom: 16rpx;
  padding: 20rpx;
}
.rem-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.rem-h .t {
  font-size: 28rpx;
  font-weight: 800;
  flex: 1;
  min-width: 0;
}
.rem-b {
  font-size: 24rpx;
  color: #6a5a4a;
  margin-top: 6rpx;
  line-height: 1.4;
}
.rem-op {
  text-align: right;
  font-size: 24rpx;
  color: #b48a5a;
  margin-top: 8rpx;
}
.rec-add {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 2;
  width: auto !important;
}
.rem-sub {
  text-align: center;
  color: #8a7a6a;
  font-size: 22rpx;
  margin: 0 0 20rpx;
  padding: 0 8rpx;
  text-decoration: underline;
}
.rem-empty {
  text-align: center;
  color: #9a8a78;
  font-size: 26rpx;
  margin: 32rpx 0;
}
.modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.35);
}
.modal-b {
  position: relative;
  width: 100%;
  max-height: 80vh;
  background: #fff8f0;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
}
.m-t {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  text-align: center;
}
.f-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}
.f-l {
  width: 150rpx;
  font-size: 26rpx;
  color: #5a4a3a;
}
.f-pv,
.f-inp {
  background: #fff;
  border: 1rpx solid #e5d5c0;
  border-radius: 12rpx;
  padding: 12rpx;
  flex: 1;
  min-width: 0;
}
