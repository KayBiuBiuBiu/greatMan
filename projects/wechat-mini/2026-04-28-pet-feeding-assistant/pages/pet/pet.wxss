.pet {
  padding: 20rpx 24rpx 40rpx;
}
.pet-top {
  margin-bottom: 20rpx;
}
.addb {
  width: 100% !important;
}
.pet-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.pt {
  padding: 10rpx 20rpx;
  background: #f5ebe0;
  color: #6a5a4a;
  border-radius: 999rpx;
  font-size: 24rpx;
}
.pt.on {
  background: #d4a574;
  color: #fff;
  font-weight: 700;
}
.pet-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.pet-empty {
  color: #9a8a78;
  font-size: 26rpx;
  margin: 24rpx 0;
}
.pet-form {
  padding: 20rpx 32rpx 40rpx;
}
.f-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}
.f-col {
  flex-direction: column;
  align-items: stretch;
}
.f-l {
  width: 160rpx;
  color: #5a4a3a;
  font-size: 28rpx;
}
.f-inp {
  flex: 1;
  background: #fff;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  min-width: 0;
  border: 1rpx solid #e5d5c0;
}
.f-pv {
  background: #fff;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e5d5c0;
  min-width: 200rpx;
}
.f-ta {
  width: 100%;
  min-height: 160rpx;
  margin-top: 10rpx;
  padding: 12rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e5d5c0;
}
.save,
.canc {
  margin-top: 20rpx;
  width: 100% !important;
}
.pet-det {
  padding: 20rpx 32rpx 40rpx;
}
.d-card {
  padding: 32rpx;
  text-align: center;
  position: relative;
}
.d-av,
.d-face {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  line-height: 120rpx;
  font-size: 56rpx;
  background: #f0e6dc;
  border-radius: 50%;
  display: block;
}
.d-face {
  line-height: 0;
  overflow: hidden;
}
.d-name {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 900;
}
.d-line,
.d-note {
  margin-top: 12rpx;
  text-align: left;
  color: #5a4a3a;
  font-size: 26rpx;
}
.d-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
  justify-content: center;
}
.d-btns button {
  min-width: 200rpx;
}
