.pcard {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(139, 115, 85, 0.08);
  position: relative;
  overflow: hidden;
}
.pcard-av {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #f5e6d3, #e8d4bc);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}
.pcard-face {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f0e6dc;
}
.pcard-body {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}
.pcard-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #3d3428;
}
.pcard-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a6a58;
}
.pcard-w {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a8a78;
}
