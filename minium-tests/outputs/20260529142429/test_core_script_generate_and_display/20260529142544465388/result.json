    "source": {
        "code": [
            "    def test_core_script_generate_and_display(self):\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "\n",
            "        snap = self._start_and_reach_read_script(page, room_id)\n",
            "        st = self._state(snap)\n",
            "        self.assertTrue(st.get(\"caseTitle\"), \"\u6848\u4ef6\u6807\u9898\u7f3a\u5931\")\n",
            "        self.assertTrue(len(st.get(\"memberList\") or []) >= 3, \"\u6210\u5458\u5217\u8868\u4e0d\u8db3 3 \u4eba\")\n",
            "\n",
            "        script_res = self._unwrap_cloud(self.cloud.get_my_script(room_id))\n",
            "        self.assertTrue(self._is_cloud_success(script_res), f\"\u62c9\u53d6\u5267\u672c\u5931\u8d25: {script_res}\")\n",
            "        script_text = script_res.get(\"script\") or \"\"\n",
            "        self.assertTrue(len(script_text) > 20, \"\u4e2a\u4eba\u5267\u672c\u4e3a\u7a7a\")\n",
            "        self.assertIn(\"\u79d8\u5bc6\", script_text, \"\u5267\u672c\u5e94\u542b\u9690\u85cf\u79d8\u5bc6\u63cf\u8ff0\")\n",
            "\n",
            "        self.assertTrue(page.has_read_script_actions(), \"\u8bfb\u672c\u9636\u6bb5\u64cd\u4f5c\u6309\u94ae\u672a\u5c55\u793a\")\n",
            "        shown = page.open_script_and_read_text()\n",
            "        self.assertTrue(len(shown) > 10, \"\u8bfb\u672c\u5f39\u5c42\u5267\u672c\u672a\u6e32\u67d3\")\n"
        ],
        "start": 273
    },
