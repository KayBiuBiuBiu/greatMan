            "\n",
            "        _, review_text = self._unlock_review_for_test(page, room_id)\n",
            "        self.assertTrue(\n",
            "            any(k in review_text for k in (\"\u5e73\u7968\", \"\u7968\u6570\u76f8\u540c\", \"\u7968\u6570\u6301\u5e73\", \"\u7968\u6570\u5747\u7b49\")),\n",
            "            f\"\u590d\u76d8\u672a\u542b\u5e73\u7968\u5206\u6790: {review_text[:120]}\",\n",
