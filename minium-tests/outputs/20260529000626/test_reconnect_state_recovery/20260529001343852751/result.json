        "code": [
            "    def test_reconnect_state_recovery(self):\n",
            "        \"\"\"\u65ad\u7ebf\u91cd\u8fde\u6062\u590d\uff1a\u9636\u6bb5\u3001\u8bc1\u636e\u3001\u6295\u7968\u3001\u8fdb\u5ea6\uff08\u4fee\u590d\u8bc1\u636e\u7a7a\u6570\u636e\uff09\"\"\"\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "        self._unwrap_cloud(self.cloud.start_game(MysteryReasonPage.game_key, room_id))\n",
            "        self._sync_room_snapshot(page, room_id)\n",
            "        self._unwrap_cloud(self.cloud.force_set_phase(room_id, \"analyze_clue\"))\n",
            "        self._unwrap_cloud(self.cloud.trigger_all_evidence(room_id))\n",
            "        self._sync_room_snapshot(page, room_id)\n",
            "\n",
            "        # \u6a21\u62df\u65ad\u7ebf\u91cd\u8fde\u5feb\u7167\u6062\u590d\n",
            "        new_snap = self._unwrap_cloud(self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id))\n",
            "        state = new_snap.get(\"state\", {})\n",
            "        self.assertEqual(state.get(\"phase\"), \"analyze_clue\")\n",
            "        self.assertTrue(len(state.get(\"publicClue\", [])) > 0, \"\u91cd\u8fde\u540e\u516c\u5171\u8bc1\u636e\u4e22\u5931\")\n"
        ],
