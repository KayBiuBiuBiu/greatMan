        "code": [
            "    def test_review_unlock_single_open_all_view(self):\n",
            "        \"\"\"\u5355\u4eba\u5206\u4eab\u89e3\u9501\u3001\u5168\u5458\u53ef\u89c1\u590d\u76d8\uff08\u4fee\u590d\u89e3\u9501\u72b6\u6001\u4e0d\u5237\u65b0\uff09\"\"\"\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "        self._unwrap_cloud(self.cloud.start_game(MysteryReasonPage.game_key, room_id))\n",
            "        self._sync_room_snapshot(page, room_id)\n",
            "        self._unwrap_cloud(self.cloud.force_set_phase(room_id, \"wait_unlock_review\"))\n",
            "        self._sync_room_snapshot(page, room_id)\n",
            "\n",
            "        # \u89e3\u9501\u524d\u6821\u9a8c\n",
            "        state_before = self._unwrap_cloud(self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)).get(\"state\", {})\n",
            "        self.assertFalse(state_before.get(\"reviewUnlocked\", False))\n",
            "\n",
            "        # \u6267\u884c\u89e3\u9501 + \u5f3a\u5236\u5237\u65b0\u5feb\u7167\n",
            "        unlock_res = self._unwrap_cloud(self.cloud.unlock_review(room_id, verify=True))\n",
            "        self.assertTrue(self._is_cloud_success(unlock_res))\n",
            "        self._sync_room_snapshot(page, room_id)\n",
            "\n",
            "        # \u89e3\u9501\u540e\u6821\u9a8c\n",
            "        state_after = self._unwrap_cloud(self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)).get(\"state\", {})\n",
            "        self.assertTrue(state_after.get(\"reviewUnlocked\", False))\n",
            "        self.assertTrue(len(state_after.get(\"reviewContent\", \"\")) > 0)\n"
        ],
        "start": 310
    },
