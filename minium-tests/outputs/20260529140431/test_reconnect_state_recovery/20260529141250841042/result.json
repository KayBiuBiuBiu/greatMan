        "code": [
            "    def test_reconnect_state_recovery(self):\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "        self._start_and_reach_read_script(page, room_id)\n",
            "        snap = self._enter_evidence_with_clues(page, room_id)\n",
            "        snap = self._go_to_phase(page, room_id, \"analyze_clue\")\n",
            "\n",
            "        new_snap = self._unwrap_cloud(\n",
            "            self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)\n",
            "        )\n",
            "        st = self._state(new_snap)\n",
            "        self.assertEqual(st.get(\"phase\"), \"analyze_clue\")\n",
            "        self.assertTrue(len(st.get(\"publicClue\") or []) > 0, \"\u91cd\u8fde\u540e\u516c\u5171\u8bc1\u636e\u4e22\u5931\")\n"
        ],
