    "source": {
        "code": [
            "    def test_evidence_round_timing_and_idempotent(self):\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "        self._start_and_reach_read_script(page, room_id)\n",
            "        self._go_to_phase(page, room_id, \"get_evidence\")\n",
            "        snap = self._sync_room_snapshot(page, room_id)\n",
            "        st = self._state(snap)\n",
            "        round_record = st.get(\"evidenceRoundRecord\") or []\n",
            "\n",
            "        if len(round_record) < 3:\n",
            "            for rnd in (1, 2, 3):\n",
            "                res = self._unwrap_cloud(self.cloud.trigger_evidence(room_id, rnd))\n",
            "                self.assertTrue(self._is_cloud_success(res), f\"\u8f6e{rnd}: {res}\")\n",
            "            r1_repeat = self._unwrap_cloud(self.cloud.trigger_evidence(room_id, 1))\n",
            "            self.assertTrue(self._is_cloud_success(r1_repeat))\n",
            "            snap = self._sync_room_snapshot(page, room_id)\n",
            "            st = self._state(snap)\n",
            "            round_record = st.get(\"evidenceRoundRecord\") or []\n",
            "\n",
            "        self.assertListEqual(sorted(round_record), [1, 2, 3])\n",
            "        self.assertTrue(len(st.get(\"publicClue\") or []) > 0, \"\u516c\u5171\u8bc1\u636e\u4e3a\u7a7a\")\n"
        ],
        "start": 333
    },
