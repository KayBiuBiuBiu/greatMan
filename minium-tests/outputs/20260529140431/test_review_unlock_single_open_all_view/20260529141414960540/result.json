        "code": [
            "    def test_review_unlock_single_open_all_view(self):\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "        self._start_and_reach_read_script(page, room_id)\n",
            "        self._go_to_phase(page, room_id, \"wait_unlock_review\")\n",
            "        snap = self._sync_room_snapshot(page, room_id)\n",
            "        self.assertFalse(self._state(snap).get(\"reviewUnlocked\"))\n",
            "\n",
            "        snap, review_text = self._unlock_review_for_test(page, room_id)\n",
            "        self.assertTrue(len(review_text) > 20, \"\u590d\u76d8\u5185\u5bb9\u4e3a\u7a7a\")\n"
        ],
