            "        before = self._unwrap_cloud(\n",
            "            self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)\n",
            "        )\n",
            "        self.assertFalse((before.get(\"state\") or {}).get(\"reviewUnlocked\"))\n",
            "\n",
            "        self._assert_ok(self.cloud.unlock_review(room_id, verify=True))\n",
            "        after = self._unwrap_cloud(\n",
            "            self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)\n",
            "        )\n",
            "        self.assertTrue((after.get(\"state\") or {}).get(\"reviewUnlocked\"))\n",
            "        content = (after.get(\"view\") or {}).get(\"reviewContent\") or \"\"\n",
            "        self.assertTrue(len(content) > 0)\n"
