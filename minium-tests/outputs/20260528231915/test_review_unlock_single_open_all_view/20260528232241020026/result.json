            "    def test_review_unlock_single_open_all_view(self):\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        self._assert_ok(self.cloud.start_game(MysteryReasonPage.game_key, room_id))\n",
            "        self._assert_ok(self.cloud.force_set_phase(room_id, \"wait_unlock_review\"))\n",
