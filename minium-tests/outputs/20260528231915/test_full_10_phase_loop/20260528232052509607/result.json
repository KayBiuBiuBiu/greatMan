            "    def test_full_10_phase_loop(self):\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "\n",
            "        self._assert_ok(self.cloud.start_game(MysteryReasonPage.game_key, room_id))\n",
            "        snap = self._unwrap_cloud(\n",
            "            self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)\n",
            "        )\n",
            "        page.apply_room_snapshot(snap)\n",
            "        page.wait_phase(\"read_script\", cloud=self.cloud, room_id=room_id)\n",
            "\n",
            "        for phase in (\n",
            "            \"public_discuss\",\n",
            "            \"get_evidence\",\n",
            "            \"analyze_clue\",\n",
            "            \"final_vote\",\n",
            "            \"wait_unlock_review\",\n",
            "        ):\n",
            "            self._assert_ok(self.cloud.force_next_phase(room_id))\n",
            "            snap = self._unwrap_cloud(\n",
            "                self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)\n",
            "            )\n",
            "            page.apply_room_snapshot(snap)\n",
            "            page.wait_phase(phase, timeout=90, cloud=self.cloud, room_id=room_id)\n",
            "\n",
            "        self._assert_ok(self.cloud.unlock_review(room_id, verify=True))\n",
            "        snap = self._unwrap_cloud(\n",
            "            self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)\n",
            "        )\n",
            "        page.apply_room_snapshot(snap)\n",
            "        page.wait_phase(\"ai_review\", cloud=self.cloud, room_id=room_id)\n",
            "\n",
            "        self._assert_ok(self.cloud.force_next_phase(room_id))\n",
            "        snap = self._unwrap_cloud(\n",
            "            self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)\n",
            "        )\n",
            "        page.apply_room_snapshot(snap)\n",
            "        page.wait_phase(\"finished\", cloud=self.cloud, room_id=room_id)\n",
            "\n",
            "        self._assert_ok(self.cloud.restart_game(room_id))\n",
            "        snap = self._unwrap_cloud(\n",
            "            self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)\n",
            "        )\n",
            "        page.apply_room_snapshot(snap)\n",
            "        page.wait_phase(\"waiting\", cloud=self.cloud, room_id=room_id)\n"
