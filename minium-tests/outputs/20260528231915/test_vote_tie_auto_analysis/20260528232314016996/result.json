    "source": {
        "code": [
            "    def test_vote_tie_auto_analysis(self):\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        self._assert_ok(self.cloud.start_game(MysteryReasonPage.game_key, room_id))\n",
            "        self._assert_ok(self.cloud.force_set_phase(room_id, \"final_vote\"))\n",
            "        tied = self._assert_ok(self.cloud.batch_vote_tie(room_id))\n",
            "        self.assertTrue(tied.get(\"tie\"))\n",
            "\n",
            "        self._assert_ok(self.cloud.force_next_phase(room_id))\n",
            "        self._assert_ok(self.cloud.unlock_review(room_id, verify=True))\n",
            "\n",
            "        state = self._unwrap_cloud(\n",
            "            self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)\n",
            "        )\n",
            "        content = (state.get(\"view\") or {}).get(\"reviewContent\") or \"\"\n",
            "        self.assertIn(\"\u5e73\u7968\", content)\n"
        ],
        "start": 230
    },
