    "source": {
        "code": [
            "    def test_full_10_phase_loop(self):\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "\n",
            "        self._start_and_reach_read_script(page, room_id)\n",
            "\n",
            "        for phase in (\n",
            "            \"public_discuss\",\n",
            "            \"get_evidence\",\n",
            "            \"analyze_clue\",\n",
            "            \"final_vote\",\n",
            "            \"wait_unlock_review\",\n",
            "        ):\n",
            "            self._go_to_phase(page, room_id, phase)\n",
            "\n",
            "        self._unlock_review_for_test(page, room_id)\n",
            "        self._wait_phase(page, room_id, \"ai_review\", timeout=120)\n",
            "\n",
            "        self._unwrap_cloud(self.cloud.force_next_phase(room_id))\n",
            "        self._wait_phase(page, room_id, \"finished\", timeout=60)\n",
            "\n",
            "        self._unwrap_cloud(self.cloud.restart_game(room_id))\n",
            "        self._wait_phase(page, room_id, \"waiting\", timeout=60)\n"
        ],
        "start": 380
    },
