        "code": [
            "    def test_core_script_generate_and_display(self):\n",
            "        \"\"\"\n",
            "        \u5267\u672c\u95ed\u73af\u5f3a\u6821\u9a8c\uff1a\n",
            "        - \u4e94\u5927\u6a21\u5757\u5b8c\u6574\uff08\u89d2\u8272\u540d/\u4e2a\u4eba\u5267\u672c/\u79d8\u5bc6/\u65f6\u95f4\u7ebf/\u6848\u4ef6\u80cc\u666f\uff09\n",
            "        - \u4e09\u4eba\u5267\u672c\u5b8c\u5168\u5dee\u5f02\u5316\n",
            "        - \u4e2a\u4eba\u5267\u672c\u9694\u79bb\uff08A \u62ff\u4e0d\u5230 B \u7684\u79d8\u5bc6/\u5267\u60c5\uff09\n",
            "        - UI \u5f39\u7a97\u56db\u533a\u5757\u6e32\u67d3\n",
            "        \"\"\"\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "\n",
            "        snap = self._start_and_reach_read_script(page, room_id)\n",
            "        st = self._state(snap)\n",
            "        case_bg = str(st.get(\"caseBackground\") or \"\").strip()\n",
            "        self.assertTrue(case_bg, \"\u6848\u4ef6\u80cc\u666f\u7f3a\u5931\")\n",
            "        self.assertGreaterEqual(\n",
            "            len(case_bg),\n",
            "            self.SCRIPT_MIN_CHARS[\"caseBackground\"],\n",
            "            \"\u6848\u4ef6\u80cc\u666f\u7bc7\u5e45\u4e0d\u8db3\",\n",
            "        )\n",
            "        self.assertTrue(st.get(\"caseTitle\"), \"\u6848\u4ef6\u6807\u9898\u7f3a\u5931\")\n",
            "        self.assertTrue(len(st.get(\"memberList\") or []) >= 3, \"\u6210\u5458\u4e0d\u8db3 3 \u4eba\")\n",
            "\n",
            "        scripts = self._fetch_all_player_scripts(room_id)\n",
            "        self._assert_scripts_all_different(scripts)\n",
            "        self._assert_script_isolation(scripts)\n",
            "\n",
            "        self.assertTrue(page.has_read_script_actions(), \"\u8bfb\u672c\u9636\u6bb5\u64cd\u4f5c\u6309\u94ae\u672a\u5c55\u793a\")\n",
            "        host_script = scripts[0][1]\n",
            "        page.assert_script_modal_sections(host_script)\n"
        ],
        "start": 333
    },
