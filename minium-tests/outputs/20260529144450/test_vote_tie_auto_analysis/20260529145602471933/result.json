    "source": {
        "code": [
            "    def test_vote_tie_auto_analysis(self):\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "        self._start_and_reach_read_script(page, room_id)\n",
            "        self._go_to_phase(page, room_id, \"final_vote\")\n",
            "\n",
            "        tie_res = self._unwrap_cloud(self.cloud.batch_vote_tie(room_id))\n",
            "        self.assertTrue(self._is_cloud_success(tie_res), f\"\u5236\u9020\u5e73\u7968\u5931\u8d25: {tie_res}\")\n",
            "\n",
            "        _, review_text = self._unlock_review_for_test(page, room_id)\n",
            "        self.assertTrue(\n",
            "            any(k in review_text for k in (\"\u5e73\u7968\", \"\u7968\u6570\u76f8\u540c\", \"\u7968\u6570\u6301\u5e73\", \"\u7968\u6570\u5747\u7b49\")),\n",
            "            f\"\u590d\u76d8\u672a\u542b\u5e73\u7968\u5206\u6790: {review_text[:120]}\",\n",
            "        )\n"
        ],
        "start": 449
    },
