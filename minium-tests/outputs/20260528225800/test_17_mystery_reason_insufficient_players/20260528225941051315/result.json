        "code": [
            "    def test_17_mystery_reason_insufficient_players(self):\n",
            "        guests = max(0, self.insufficient_players - 1)\n",
            "        room_id, room_code, snap = self._tcb_setup_room(guests)\n",
            "        host = self._ui_bootstrap(snap)\n",
            "\n",
            "        host.wait_member_count_at_least(self.insufficient_players, timeout=20)\n",
            "        self.assertFalse(\n",
            "            host.is_start_enabled(),\n",
            "            \"2 \u4eba\u65f6\u5f00\u59cb\u4e92\u52a8\u5e94\u4e0d\u53ef\u7528\",\n",
            "        )\n",
            "\n",
            "        add = self.min_players - self.insufficient_players\n",
            "        if add > 0:\n",
            "            self._unwrap_cloud(\n",
            "                self.cloud.seed_players(\n",
            "                    MysteryReasonPage.game_key,\n",
            "                    room_id=room_id,\n",
            "                    count=add,\n",
            "                    start_index=self.insufficient_players,\n",
            "                )\n",
            "            )\n",
            "            snap = self._unwrap_cloud(\n",
            "                self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)\n",
            "            )\n",
            "            host.apply_room_snapshot(snap)\n",
            "            host.sleep(2)\n",
            "\n",
            "        host.wait_member_count_at_least(self.min_players, timeout=20)\n",
            "        self.assertTrue(\n",
            "            host.is_start_enabled(),\n",
            "            \"3 \u4eba\u65f6\u5f00\u59cb\u4e92\u52a8\u5e94\u53ef\u7528\",\n",
            "        )\n",
            "\n",
            "        started = self._unwrap_cloud(\n",
            "            self.cloud.start_game(MysteryReasonPage.game_key, room_id)\n",
            "        )\n",
            "        self.assertFalse(started.get(\"errMsg\"), str(started.get(\"errMsg\")))\n",
            "        snap = self._unwrap_cloud(\n",
            "            self.cloud.sync_snapshot(MysteryReasonPage.game_key, room_id)\n",
            "        )\n",
            "        host.apply_room_snapshot(snap)\n",
            "        host.wait_phase_text(\"\u8bfb\u672c\", timeout=120, cloud=self.cloud, room_id=room_id)\n",
            "        host.assert_no_error_toast_or_modal()\n"
        ],
        "start": 115
    },
