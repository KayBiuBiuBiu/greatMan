        "code": [
            "    def test_review_unlock_single_open_all_view(self):\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "        self._start_and_reach_read_script(page, room_id)\n",
            "        self._unwrap_cloud(self.cloud.force_set_phase(room_id, \"wait_unlock_review\"))\n",
            "        snap = self._sync_room_snapshot(page, room_id)\n",
            "        self.assertFalse(self._state(snap).get(\"reviewUnlocked\"))\n",
            "\n",
            "        unlock_res = self._unwrap_cloud(self.cloud.unlock_review(room_id, verify=True))\n",
            "        if not self._is_cloud_success(unlock_res):\n",
            "            unlock_res = self._unwrap_cloud(self.cloud.advance_to_ai_review(room_id))\n",
            "        self.assertTrue(self._is_cloud_success(unlock_res), f\"\u89e3\u9501\u590d\u76d8\u5931\u8d25: {unlock_res}\")\n",
            "\n",
            "        snap = self._sync_room_snapshot(page, room_id)\n",
            "        st, vw = self._state(snap), self._view(snap)\n",
            "        self.assertTrue(st.get(\"reviewUnlocked\") or vw.get(\"reviewUnlocked\"))\n",
            "        review_text = vw.get(\"reviewContent\") or unlock_res.get(\"data\") or \"\"\n",
            "        if isinstance(review_text, dict):\n",
            "            review_text = \"\"\n",
            "        self.assertTrue(len(str(review_text)) > 20, \"\u590d\u76d8\u5185\u5bb9\u4e3a\u7a7a\")\n"
        ],
