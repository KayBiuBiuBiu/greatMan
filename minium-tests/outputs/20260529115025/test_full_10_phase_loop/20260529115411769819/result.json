            "        for phase in (\n",
            "            \"public_discuss\",\n",
            "            \"get_evidence\",\n",
            "            \"analyze_clue\",\n",
            "            \"final_vote\",\n",
            "            \"wait_unlock_review\",\n",
            "        ):\n",
            "            self._unwrap_cloud(self.cloud.force_next_phase(room_id))\n",
            "            self._wait_phase(page, room_id, phase, timeout=90)\n",
