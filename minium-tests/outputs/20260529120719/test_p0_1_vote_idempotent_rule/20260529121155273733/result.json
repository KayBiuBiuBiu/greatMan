    "source": {
        "code": [
            "    def test_p0_1_vote_idempotent_rule(self):\n",
            "        room_id, _, snap = self._tcb_create_full_room(3)\n",
            "        page = self._ui_init_room(snap)\n",
            "\n",
            "        self._unwrap_cloud(self.cloud.force_set_phase(room_id, \"final_vote\"))\n",
            "        snap = self._sync_room_snapshot(page, room_id)\n",
            "        target_a, target_b = self._vote_targets(snap)\n",
            "\n",
            "        v1 = self._unwrap_cloud(self.cloud.submit_vote(room_id, target_a))\n",
            "        self.assertTrue(self._is_cloud_success(v1), f\"\u9996\u6b21\u6295\u7968\u5931\u8d25: {v1}\")\n",
            "\n",
            "        v2 = self._unwrap_cloud(self.cloud.submit_vote(room_id, target_a))\n",
            "        self.assertTrue(self._is_cloud_success(v2), f\"\u91cd\u590d\u6295\u7968\u5931\u8d25: {v2}\")\n",
            "\n",
            "        v3 = self._unwrap_cloud(self.cloud.submit_vote(room_id, target_b))\n",
            "        self.assertTrue(self._is_cloud_success(v3), f\"\u6539\u7968\u5931\u8d25: {v3}\")\n",
            "\n",
            "        snap = self._sync_room_snapshot(page, room_id)\n",
            "        my_vote = self._view(snap).get(\"myVoteTarget\")\n",
            "        vote_data = v3.get(\"data\") if isinstance(v3.get(\"data\"), dict) else {}\n",
            "        self.assertTrue(\n",
            "            my_vote == target_b or vote_data.get(page.openId) == target_b,\n",
            "            f\"\u6539\u7968\u672a\u751f\u6548 myVoteTarget={my_vote} data={vote_data}\",\n",
            "        )\n"
        ],
        "start": 241
    },
